---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/legal.css';

interface Props {
  title: string;
  description: string;
  canonical: URL | string;
  heading: string;
  updated?: string;
  product?: string;
}

const { title, description, canonical, heading, updated, product } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav
    product={product}
    links={[
      { href: '/', label: product ?? 'Company' },
      { href: '/support', label: 'Support' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ]}
  />
  <main id="main" class="legal shell">
    <header class="legal__header" data-reveal>
      <p class="eyebrow">{product ?? 'Camm Studios'}</p>
      <h1>{heading}</h1>
      {updated && <p class="legal__updated">Last updated {updated}</p>}
    </header>
    <article class="legal__body" data-reveal>
      <slot />
    </article>
  </main>
  <Footer product={product} />
</BaseLayout>
