---
import '@fontsource-variable/manrope';
import '@fontsource/geist-mono';
import '@shared/styles/global.css';
import { canonical, target } from '@shared/lib/site';

interface Props {
  title: string;
  description: string;
  /** absolute or site-relative og image; defaults to /og.png in the site's public dir */
  ogImage?: string;
  /** extra JSON-LD blocks */
  jsonld?: object[];
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, ogImage = '/og.png', jsonld = [], bodyClass = '', noindex = false } =
  Astro.props;
const canonicalUrl = canonical(Astro.url.pathname);
const ogUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Camm Studios" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {target !== 'company' && <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />}

    {jsonld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <script defer src="/_vercel/insights/script.js"></script>
    <script defer src="/_vercel/speed-insights/script.js"></script>
  </head>
  <body class={bodyClass}>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script src="@shared/scripts/motion.ts"></script>
  </body>
</html>
