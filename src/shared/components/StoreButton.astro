---
interface Props {
  href: string;
  label?: string;
  class?: string;
}

const { href, label = 'Download on the App Store', class: className = '' } = Astro.props;
---

<a class:list={['button', 'button--store', className]} href={href} aria-label={label}>
  <svg viewBox="0 0 22 26" width="18" height="21" aria-hidden="true">
    <path fill="currentColor" d="M18.2 13.8c0-3.1 2.6-4.6 2.7-4.7a5.7 5.7 0 0 0-4.5-2.4c-1.9-.2-3.7 1.1-4.6 1.1-.9 0-2.4-1.1-4-1.1a5.9 5.9 0 0 0-5 3c-2.1 3.7-.5 9.2 1.5 12.2 1 1.5 2.2 3.1 3.8 3 1.5-.1 2.1-1 3.9-1s2.3 1 3.9 1c1.6 0 2.6-1.5 3.6-3 1.2-1.7 1.6-3.4 1.7-3.5-.1 0-3-.9-3-4.6ZM15.2 4.7A5.2 5.2 0 0 0 16.4.9a5.4 5.4 0 0 0-3.6 1.8 5 5 0 0 0-1.3 3.7 4.5 4.5 0 0 0 3.7-1.7Z"/>
  </svg>
