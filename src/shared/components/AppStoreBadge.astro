---
/**
 * The primary download action for an app. One per section, per A4.
 */
interface Props {
  href: string;
  tone?: 'ink' | 'paper';
  label?: string;
}
const { href, tone = 'ink', label = 'Download on the App Store' } = Astro.props;
---

<a class={`store-badge store-badge--${tone}`} href={href} rel="noopener">
  <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path
      d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.031 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702"
    ></path>
  </svg>
  <span class="badge-text">
    <span class="badge-small">Free on the</span>
    <span class="badge-big">App Store</span>
  </span>
  <span class="visually-hidden">{label}</span>
</a>

<style>
  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-100);
    padding: var(--sp-100) var(--sp-300);
    border-radius: 2px;
    text-decoration: none;
    transition: transform 700ms var(--ease-fluid), background-color 700ms var(--ease-fluid);
  }
  .store-badge:hover { transform: translateY(-2px); }
  .store-badge:active { transform: translateY(1px) scale(0.98); }
  .store-badge--ink { background: var(--ink); color: var(--paper); }
  .store-badge--ink:hover { background: var(--accent); }
  .store-badge--paper { background: var(--paper); color: var(--ink); }
  .store-badge--paper:hover { background: #ffffff; }
  .badge-text { display: grid; line-height: 1.1; text-align: left; }
  .badge-small { font-size: var(--text-xs); font-weight: 500; opacity: 0.8; }
  .badge-big { font-size: var(--text-lg); font-weight: 700; letter-spacing: -0.01em; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
