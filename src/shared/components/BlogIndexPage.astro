---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AppShell from '@shared/components/AppShell.astro';
import type { AppDefinition } from '@shared/data/apps';

interface Props {
  app: AppDefinition;
  posts: CollectionEntry<'blog'>[];
}
const { app, posts } = Astro.props;
const sorted = [...posts].sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<AppShell
  app={app}
  title={`Blog — ${app.name}`}
  description={`Articles from the ${app.name} team at Camm Studios.`}
>
  <main id="main" class="subpage">
    <div class="shell">
      <header class="page-head">
        <p class="kicker kicker--rule">The {app.name} blog</p>
        <h1 class="display-lg">Notes &amp; guides</h1>
      </header>
      <div class="post-list">
        {sorted.map((post) => (
          <a class="card post-card reveal" href={`/blog/${post.id}`}>
            <Image
              src={post.data.hero}
              alt={post.data.heroAlt}
              widths={[480, 760, 1080]}
              sizes="(min-width: 900px) 560px, 100vw"
              format="avif"
              quality={60}
              class="post-img"
            />
            <div class="post-copy">
              <p class="mono-note">{fmt(post.data.publishDate)}</p>
              <h2>{post.data.title}</h2>
              <p class="post-summary">{post.data.summary}</p>
              <p class="post-more">Read the article <span aria-hidden="true">→</span></p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</AppShell>

<style>
  .subpage { padding-top: calc(var(--sp-900) + var(--sp-500)); padding-bottom: var(--sp-900); }
  .page-head { margin-bottom: var(--sp-600); }
  .page-head h1 { margin-top: var(--sp-200); }
  .post-list { display: grid; gap: var(--sp-400); }
  .post-card {
    display: grid;
    overflow: hidden;
    text-decoration: none;
    transition: transform 700ms var(--ease-fluid), box-shadow 700ms var(--ease-fluid);
  }
  @media (min-width: 900px) {
    .post-card { grid-template-columns: 1fr 1fr; align-items: center; }
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -24px color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .post-card :global(.post-img) { width: 100%; height: 100%; object-fit: cover; }
  .post-copy { padding: var(--sp-400); display: grid; gap: var(--sp-200); }
  .post-copy h2 { font-size: var(--text-2xl); line-height: var(--lh-2xl); }
  .post-summary { color: var(--ink-soft); }
  .post-more { font-weight: 600; color: var(--accent); }
</style>
