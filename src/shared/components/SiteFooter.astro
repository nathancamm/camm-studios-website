---
import Mark from '@shared/components/Mark.astro';
import { company } from '@shared/data/apps';

interface FooterLink {
  label: string;
  href: string;
}
interface Props {
  /** heading shown above the giant wordmark */
  note?: string;
  columns: { title: string; links: FooterLink[] }[];
}
const { note = 'An independent app studio.', columns } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="band--night footer">
  <div class="shell">
    <p class="module-head footer-head">
      <span><span class="module-id">[ end ]</span> Transmission complete</span>
      <span>Camm Studios · independent app studio</span>
    </p>
    <div class="top">
      <div class="brand-block">
        <Mark size={40} tone="paper" />
        <p class="note">{note}</p>
      </div>
      <div class="cols">
        {columns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="kicker">{col.title}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={link.href.startsWith('http') ? 'noopener' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <p class="wordmark" aria-hidden="true">Camm Studios</p>
    <div class="legal-row">
      <p class="mono-note">© {year} Camm Studios</p>
      <p class="mono-note">
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: var(--sp-400); border-top: 1px solid var(--night-line); }
  .footer-head { margin-bottom: var(--sp-600); }
  .top {
    display: grid;
    gap: var(--sp-600);
    padding-bottom: var(--sp-700);
  }
  @media (min-width: 768px) {
    .top { grid-template-columns: 1fr 2fr; }
  }
  .brand-block { display: grid; gap: var(--sp-300); align-content: start; justify-items: start; }
  .note { color: var(--night-soft); max-width: 260px; }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-500);
  }
  @media (min-width: 768px) {
    .cols { grid-template-columns: repeat(3, 1fr); justify-items: start; }
  }
  .cols h2 { margin-bottom: var(--sp-200); }
  .cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-100); }
  .cols a {
    color: var(--night-text);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    font-weight: 600;
  }
  .cols a:hover { color: var(--accent-bright); }

  .wordmark {
    font-size: clamp(3rem, 12vw, 9.5rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--night-text) 14%, transparent);
    user-select: none;
    padding-bottom: var(--sp-500);
  }
  .legal-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-200);
    border-top: 1px solid var(--night-line);
    padding-top: var(--sp-300);
  }
  .legal-row a { color: inherit; text-decoration: none; }
  .legal-row a:hover { color: var(--accent-bright); }
</style>
