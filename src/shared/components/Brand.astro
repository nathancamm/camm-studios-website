---

interface Props {
  product?: string;
}

const { product } = Astro.props;
---

<a class="brand" href="/" aria-label={`${product ?? 'Camm Studios'} home`}>
  <span class="brand__mark" aria-hidden="true"><svg viewBox="0 0 32 32" width="26" height="26" fill="none"><path d="M24 8H12a4 4 0 0 0-4 4v9a4 4 0 0 0 4 4h12v-5M8 16h10" stroke="currentColor" stroke-width="5" stroke-linejoin="round" /><rect x="21" y="5" width="8" height="8" rx="2" fill="currentColor" /><circle cx="25" cy="9" r="1.5" fill="white" /></svg></span>
  <span class="brand__name">Camm Studios</span>
  {product && <span class="brand__product">/ {product}</span>}
</a>
