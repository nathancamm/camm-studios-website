---
interface Props {
  product?: string;
}

const { product } = Astro.props;
---

<footer class="site-footer">
  <div class="footer__top">
    <p class="eyebrow">Camm Studios</p>
    <p class="footer__line">Small apps. Clear purpose. Built to get better.</p>
  </div>
  <div class="footer__bottom">
    <p>© {new Date().getFullYear()} Camm Studios</p>
    <nav aria-label="Footer navigation">
      {product && <a href="/">{product}</a>}
      <a href="/support">Support</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="https://www.cammstudios.com">Company</a>
    </nav>
  </div>
</footer>
