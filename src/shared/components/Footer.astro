---
interface Props {
  product?: string;
}

const { product } = Astro.props;
---

<footer class="site-footer">
  <div class="footer__top">
    <p class="eyebrow">Camm Studios / Independent app company</p>
    <p class="footer__line">Focused products.<br />Shared intelligence.<br />Compounding craft.</p>
  </div>
  <div class="footer__bottom">
    <p>© {new Date().getFullYear()} Camm Studios</p>
    <nav aria-label="Footer navigation">
      {product && <a href="/">{product}</a>}
      <a href="/support">Support</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      {product
        ? <a href="https://www.cammstudios.com">Company</a>
        : <><a href="https://bronzed.cammstudios.com">Bronzed</a><a href="https://stellar.cammstudios.com">Stellar</a></>}
    </nav>
  </div>
</footer>
