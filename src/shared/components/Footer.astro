---
import GlassFooter from './GlassFooter';

interface Props {
  product?: string;
}

const { product } = Astro.props;
---

<GlassFooter client:visible>
  <div class="footer__top">
    <div class="footer__identity"><p class="eyebrow">Camm Studios / Independent app studio</p>
    <p class="footer__line">Small apps.<br />Built with care.<br />Made to last.</p></div>
    <nav aria-label="Footer navigation">
      {product && <a href="/">{product}</a>}
      <a href="/support">Support</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      {product
        ? <a href="https://www.cammstudios.com">Company</a>
        : <><a href="https://bronzed.cammstudios.com">Bronzed</a><a href="https://apps.apple.com/app/id6759896200">Stellar</a></>}
    </nav>
  </div>
  <div class="footer__bottom"><p>© {new Date().getFullYear()} Camm Studios</p></div>
</GlassFooter>
