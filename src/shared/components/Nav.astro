---
import Brand from './Brand.astro';

interface Link {
  href: string;
  label: string;
}

interface Props {
  product?: string;
  links?: Link[];
  storeUrl?: string;
}

const { product, storeUrl, links = [] } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <nav class="nav-island" aria-label="Primary navigation">
    <Brand product={product} />
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-panel">
      <span class="sr-only">Open menu</span>
      <span></span><span></span>
    </button>
    <div class="nav-panel" id="nav-panel">
      <div class="nav-links">
        {links.map((link, index) => {
          const hrefPath = link.href.replace(/\/$/, '') || '/';
          const isCurrent = !link.href.startsWith('#') && hrefPath === currentPath;
          return <a href={link.href} aria-current={isCurrent ? 'page' : undefined}><span>0{index + 1}</span>{link.label}</a>;
        })}
      </div>
      {storeUrl && <a class="button button--compact button--light" href={storeUrl}>Get {product}</a>}
    </div>
  </nav>
</header>
