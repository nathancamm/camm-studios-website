---
/**
 * The Camm Studios mark: an orange world with a thin orbit ring.
 * The ring passes behind the planet, then in front. Everything the
 * studio ships is a small world in orbit.
 */
interface Props {
  size?: number;
  tone?: 'ink' | 'paper';
}
const { size = 28, tone = 'ink' } = Astro.props;
const ring = tone === 'paper' ? 'var(--paper)' : 'var(--ink)';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  role="img"
  aria-label="Camm Studios mark"
>
  <g transform="rotate(-24 32 32)">
    <path d="M6 32 A26 9.5 0 0 1 58 32" stroke={ring} stroke-width="3" stroke-linecap="round"></path>
    <circle cx="32" cy="32" r="14" fill="var(--accent)"></circle>
    <path d="M6 32 A26 9.5 0 0 0 58 32" stroke={ring} stroke-width="3" stroke-linecap="round"></path>
    <circle cx="13" cy="37.5" r="2.8" fill={ring}></circle>
  </g>
</svg>
