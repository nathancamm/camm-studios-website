---
/**
 * The original Camm Studios mark, in ink or paper depending on the ground.
 */
import { Image } from 'astro:assets';
import logoInk from '@shared/assets/brand/logo-ink.png';
import logoPaper from '@shared/assets/brand/logo-paper.png';

interface Props {
  size?: number;
  tone?: 'ink' | 'paper';
}
const { size = 28, tone = 'ink' } = Astro.props;
const src = tone === 'paper' ? logoPaper : logoInk;
const width = Math.round(size * (409 / 384));
---

<Image src={src} alt="Camm Studios mark" width={width} height={size} densities={[1, 2]} />
