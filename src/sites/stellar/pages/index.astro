---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import AppShell from '@shared/components/AppShell.astro';
import AppStoreBadge from '@shared/components/AppStoreBadge.astro';
import WordReveal from '@shared/components/WordReveal.astro';
import Faq from '@shared/components/Faq.astro';
import { stellar } from '@shared/data/apps';
import heroArt from '@shared/assets/art/stellar-hero.png';
import heroArtB from '@shared/assets/art/stellar-hero-b.png';
import shot01 from '@shared/assets/shots/stellar-01.png';
import shot02 from '@shared/assets/shots/stellar-02.png';
import shot03 from '@shared/assets/shots/stellar-03.png';
import shot04 from '@shared/assets/shots/stellar-04.png';
import shot05 from '@shared/assets/shots/stellar-05.png';

const heroBg = await getImage({ src: heroArt, format: 'avif', quality: 60, width: 2200 });
const heroBgB = await getImage({ src: heroArtB, format: 'avif', quality: 60, width: 2200 });

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 1);

const features = [
  {
    kicker: 'Daily affirmations',
    title: 'The first words of your day, chosen by you',
    body: 'Full-screen cards, one line at a time. Hundreds of curated affirmations across prosperity, gratitude, self-love, and confidence, or write your own. Keep the ones that hit.',
    shot: shot04,
    alt: 'A full-screen Stellar affirmation card reading “Success is my natural state and I step into it fully”',
  },
  {
    kicker: 'The 369 journal',
    title: 'Three rounds a day, guided',
    body: 'Write your intention 3 times in the morning, 6 in the afternoon, 9 at night. Stellar walks you through each round and marks the calendar. Miss one, and the next reminder is already set.',
    shot: shot05,
    alt: 'The Stellar 369 journal screen with morning, afternoon, and evening rounds and an intention field',
  },
  {
    kicker: 'Vision board',
    title: 'Keep the goal where you can see it',
    body: 'A private board built from your own photos: the trip, the house, the version of you this is all for. One tap away, never uploaded.',
    shot: shot03,
    alt: 'A Stellar vision board filled with sunset photos, travel images, and a “Happy mind, happy life” card',
  },
  {
    kicker: 'Widgets and reminders',
    title: 'Your words, everywhere you look',
    body: 'Affirmations on the Lock Screen, widgets on the Home Screen, notifications timed to your day. You stop going to the practice. It comes to you.',
    shot: shot02,
    alt: 'Stellar affirmation widgets on an iPhone Lock Screen and Home Screen',
  },
  {
    kicker: 'Streaks',
    title: 'The habit, made visible',
    body: 'Streaks count your affirmations, journal rounds, and check-ins. Nothing motivates like a number you refuse to reset.',
    shot: shot01,
    alt: 'A Stellar lock screen notification delivering a daily affirmation at 11:11',
  },
];

const faqs = [
  {
    q: 'What is the 369 method?',
    a: 'A journaling practice: write one intention 3 times in the morning, 6 in the afternoon, 9 at night. Stellar guides each round and keeps the streak. There is a <a href="/blog/369-method-daily-ritual">full guide on the blog</a>.',
  },
  {
    q: 'Does manifestation actually work?',
    a: 'We will not promise the universe rearranges itself. Here is what the practice reliably does: it puts one goal in front of you every day, and people who see a goal daily act on it more. That part is not magic. It is attention.',
  },
  {
    q: 'Is Stellar free?',
    a: 'Free to download and use. Everything unlocks for $29.99/year with a 3-day free trial. Cancel anytime in your Apple Account settings.',
  },
  {
    q: 'Are my journal entries private?',
    a: 'Yes. Entries, custom affirmations, and vision board photos stay on your phone. Nothing is uploaded, so we could not read them if we tried. See the <a href="/privacy">privacy policy</a>.',
  },
  {
    q: 'Can I write my own affirmations?',
    a: 'Yes, as many as you want, alongside the curated library. Favorite anything to build your own rotation.',
  },
  {
    q: 'Can I change my reminder times?',
    a: 'Yes. Each 369 round and the daily affirmation can be scheduled to fit your day, or switched off.',
  },
  {
    q: 'Is Stellar a mental health app?',
    a: 'No. It is a reflection tool, not therapy. If you are struggling, talk to a professional, not an app.',
  },
];
---

<AppShell
  app={stellar}
  title="Stellar — Daily affirmations, 369 journal & vision board"
  description="Daily affirmations, a guided 369 manifestation journal, and a private vision board in one calm space. Free on the App Store."
>
  <main id="main">
    <!-- hero -->
    <section class="hero band--night">
      <div class="hero-bg living" aria-hidden="true">
        <img src={heroBg.src} alt="" class="hero-bg-img" fetchpriority="high" />
        <img src={heroBgB.src} alt="" class="hero-bg-img frame-b" loading="lazy" />
      </div>
      <div class="hero-scrim"></div>
      <svg class="hero-stars" viewBox="0 0 1440 500" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
        {[
          [100, 70, 1.6, 0], [260, 160, 1.1, 1.4], [400, 50, 1.9, 2.2], [560, 130, 1.2, 0.7],
          [720, 80, 1.5, 2.9], [880, 190, 1.1, 1.8], [1030, 60, 1.8, 0.3], [1180, 150, 1.3, 2.5],
          [1320, 90, 1.6, 1.2], [640, 240, 1.1, 3.4], [180, 260, 1.2, 2.7], [1250, 280, 1.2, 0.9],
        ].map(([x, y, r, d]) => (
          <circle cx={x} cy={y} r={r} fill="#ffffff" style={`animation: twinkle ${3 + (d % 2)}s var(--ease-fluid) ${d}s infinite`} />
        ))}
      </svg>
      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="kicker rise" style="--d: 150ms">Stellar — Daily affirmations</p>
          <h1 class="display-xl ink-fade--night">
            <span class="rise" style="--d: 280ms">Speak it.</span><br />
            <span class="rise" style="--d: 420ms">Write it. See it.</span>
          </h1>
          <p class="lede rise" style="--d: 580ms">
            Affirmations, a guided 369 journal, and a private vision board. One calm ritual,
            morning to night.
          </p>
          <div class="hero-cta rise" style="--d: 720ms">
            <AppStoreBadge href={stellar.appStoreUrl} tone="paper" />
            <p class="mono-note">iOS {stellar.minimumOs}+ · Your words never leave your phone</p>
          </div>
        </div>
        <div class="hero-shot rise" style="--d: 860ms">
          <div data-parallax="0.06">
            <Image
              src={shot04}
              alt="A full-screen Stellar affirmation card"
              widths={[320, 480, 640]}
              sizes="(min-width: 900px) 380px, 70vw"
              format="avif"
              quality={70}
              loading="eager"
              class="shot-img"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- features -->
    <section class="band" id="features" aria-labelledby="features-title">
      <div class="shell">
        <p class="kicker kicker--rule reveal">What it does</p>
        <h2 id="features-title" class="display-lg reveal">
          A ritual,<br />not another feed.
        </h2>
        <div class="feature-list">
          {features.map((f, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--flip' : ''}`}>
              <div class="feature-copy reveal">
                <p class="index-no">{String(i + 1).padStart(2, '0')}</p>
                <p class="kicker">{f.kicker}</p>
                <h3 class="display-md">{f.title}</h3>
                <p class="feature-body">{f.body}</p>
              </div>
              <div class="feature-shot reveal" style="--reveal-delay: 100ms">
                <div data-parallax={i % 2 === 0 ? '0.05' : '0.035'}>
                  <Image
                    src={f.shot}
                    alt={f.alt}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 900px) 400px, 80vw"
                    format="avif"
                    quality={70}
                    class="shot-img"
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- how it works -->
    <section class="band band--deep" aria-labelledby="how-title">
      <div class="shell">
        <p class="kicker kicker--rule reveal">How it works</p>
        <h2 id="how-title" class="display-lg reveal">One sentence, three moments.</h2>
        <ol class="steps">
          {[
            {
              t: 'Choose your intention',
              d: 'Pick a line from the library or write the sentence that matters to you right now.',
            },
            {
              t: 'Follow the rounds',
              d: 'Morning, afternoon, evening. Stellar reminds you and guides each writing round.',
            },
            {
              t: 'Keep the streak',
              d: 'Watch the calendar fill. A month in, the ritual runs itself.',
            },
          ].map((step, i) => (
            <li class="step reveal" style={`--reveal-delay: ${i * 80}ms`}>
              <p class="index-no">{String(i + 1).padStart(2, '0')}</p>
              <h3>{step.t}</h3>
              <p>{step.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- tagline moment -->
    <section class="band" aria-label="Why Stellar exists">
      <div class="shell">
        <WordReveal
          class="display-lg motto"
          text="You already talk to yourself all day. Stellar makes it deliberate."
        />
      </div>
    </section>

    <!-- privacy -->
    <section class="band band--night" aria-labelledby="privacy-title">
      <div class="shell">
        <p class="kicker kicker--rule reveal">Private by design</p>
        <h2 id="privacy-title" class="display-lg ink-fade--night reveal">
          Your words stay yours.
        </h2>
        <div class="science-grid">
          <div class="science-item reveal">
            <h3>On-device journal</h3>
            <p>
              Entries, custom affirmations, and vision board photos live on your phone. Nothing is
              uploaded. We could not read your journal if we wanted to.
            </p>
          </div>
          <div class="science-item reveal" style="--reveal-delay: 70ms">
            <h3>No feed, no comparison</h3>
            <p>
              No social layer, no likes, nothing to scroll. Stellar is a room with your own words
              in it, and it closes when you are done.
            </p>
          </div>
          <div class="science-item reveal" style="--reveal-delay: 140ms">
            <h3>Honest expectations</h3>
            <p>
              We promise the practice, not miracles. The ritual sharpens attention and builds a
              habit. What you do with that is yours. Details in the
              <a href="/privacy">privacy policy</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- faq -->
    <section class="band" id="faq" aria-labelledby="faq-title">
      <div class="shell faq-shell">
        <p class="kicker kicker--rule reveal">Questions</p>
        <h2 id="faq-title" class="display-lg reveal">Before you ask</h2>
        <Faq items={faqs} />
      </div>
    </section>

    <!-- blog preview -->
    {posts.length > 0 && (
      <section class="band band--deep" aria-labelledby="blog-title">
        <div class="shell">
          <p class="kicker kicker--rule reveal">From the blog</p>
          <h2 id="blog-title" class="display-lg reveal">The practice, explained.</h2>
          <div class="blog-grid">
            {posts.map((post) => (
              <a class="card blog-card reveal" href={`/blog/${post.id}`}>
                <Image
                  src={post.data.hero}
                  alt={post.data.heroAlt}
                  widths={[480, 760, 1080]}
                  sizes="(min-width: 900px) 760px, 100vw"
                  format="avif"
                  quality={60}
                  class="blog-img"
                />
                <div class="blog-copy">
                  <p class="mono-note">
                    {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </p>
                  <h3>{post.data.title}</h3>
                  <p class="blog-summary">{post.data.summary}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- final CTA -->
    <section class="band band--night cta-final" aria-labelledby="cta-title">
      <div class="shell cta-inner">
        <h2 id="cta-title" class="display-lg ink-fade--night reveal">
          Tonight, write it<br />nine times.
        </h2>
        <div class="reveal" style="--reveal-delay: 100ms">
          <AppStoreBadge href={stellar.appStoreUrl} tone="paper" />
        </div>
        <p class="mono-note reveal" style="--reveal-delay: 160ms">
          Free download · Premium $29.99/year with a 3-day trial
        </p>
      </div>
    </section>
  </main>
</AppShell>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--sp-900) + var(--sp-600));
    padding-bottom: var(--sp-800);
    overflow: clip;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    animation: drift-pan 44s var(--ease-fluid) infinite alternate;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--night) 30%, transparent);
  }
  .hero-stars {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 70%;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    gap: var(--sp-600);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.2fr 0.8fr; }
  }
  .hero-copy { display: grid; gap: var(--sp-300); justify-items: start; }
  .hero-cta { display: grid; gap: var(--sp-200); justify-items: start; }
  .hero .kicker { color: var(--night-text); }
  .hero .lede { color: color-mix(in srgb, var(--night-text) 88%, transparent); }
  .hero .mono-note { color: color-mix(in srgb, var(--night-text) 72%, transparent); }
  .hero-shot { justify-self: center; }
  .hero-shot :global(.shot-img) {
    width: min(340px, 70vw);
    border-radius: 32px;
    transform: rotate(-2.5deg);
    box-shadow: 0 48px 96px -32px color-mix(in srgb, var(--night) 85%, transparent);
  }

  .feature-list { margin-top: var(--sp-700); display: grid; gap: var(--sp-800); }
  .feature {
    display: grid;
    gap: var(--sp-400);
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: var(--sp-600);
  }
  @media (min-width: 900px) {
    .feature { grid-template-columns: 1fr 1fr; gap: var(--sp-800); }
    .feature--flip .feature-copy { order: 2; }
    .feature--flip .feature-shot { order: 1; }
  }
  .feature-copy { display: grid; gap: var(--sp-200); }
  .feature-body { color: var(--ink-soft); max-width: 480px; font-size: var(--text-lg); line-height: var(--lh-lg); }
  .feature-shot { justify-self: center; }
  .feature-shot :global(.shot-img) {
    width: min(400px, 80vw);
    border-radius: 24px;
    border: 1px solid var(--line);
  }

  .steps {
    list-style: none;
    margin: var(--sp-700) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-400);
  }
  @media (min-width: 768px) {
    .steps { grid-template-columns: repeat(3, 1fr); }
  }
  .step {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: var(--sp-400);
    display: grid;
    gap: var(--sp-100);
    align-content: start;
  }
  .step h3 { font-size: var(--text-xl); line-height: var(--lh-xl); }
  .step p:last-child { color: var(--ink-soft); }

  .motto { max-width: 680px; }

  .science-grid {
    margin-top: var(--sp-700);
    display: grid;
    gap: var(--sp-400);
  }
  @media (min-width: 768px) {
    .science-grid { grid-template-columns: repeat(3, 1fr); gap: var(--sp-500); }
  }
  .science-item { border-top: 1px solid var(--night-line); padding-top: var(--sp-300); }
  .science-item h3 { font-size: var(--text-xl); line-height: var(--lh-xl); }
  .science-item p { margin-top: var(--sp-100); color: var(--night-soft); }
  .science-item a { color: var(--night-text); }

  .faq-shell { max-width: 800px; }
  .faq-shell h2 { margin-bottom: var(--sp-500); }

  .blog-grid { margin-top: var(--sp-600); display: grid; }
  .blog-card {
    text-decoration: none;
    overflow: hidden;
    display: grid;
    transition: transform 700ms var(--ease-fluid), box-shadow 700ms var(--ease-fluid);
  }
  @media (min-width: 900px) {
    .blog-card { grid-template-columns: 1fr 1fr; align-items: center; }
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -24px color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .blog-card :global(.blog-img) { width: 100%; height: 100%; object-fit: cover; }
  .blog-copy { padding: var(--sp-400); display: grid; gap: var(--sp-200); }
  .blog-copy h3 { font-size: var(--text-2xl); line-height: var(--lh-2xl); }
  .blog-summary { color: var(--ink-soft); }

  .cta-inner {
    display: grid;
    gap: var(--sp-400);
    justify-items: center;
    text-align: center;
  }
</style>
