---
import CompanyShell from '../components/CompanyShell.astro';
import Faq from '@shared/components/Faq.astro';
import { apps, company } from '@shared/data/apps';

const faqs = [
  {
    q: 'How do I cancel my subscription?',
    a: 'Open the <strong>Settings</strong> app on your iPhone, tap your name at the top, then tap <strong>Subscriptions</strong>. Find the app subscription and tap <strong>Cancel Subscription</strong>.',
  },
  {
    q: 'How do I restore my purchase on a new device?',
    a: 'Open the app, go to <strong>Settings</strong>, and tap <strong>Restore Purchases</strong>. Make sure you are signed in with the same Apple Account you used for the original purchase.',
  },
  {
    q: 'Can I get a refund?',
    a: 'Refunds are handled by Apple. Visit <a href="https://reportaproblem.apple.com" rel="noopener">reportaproblem.apple.com</a>, sign in with your Apple Account, find the purchase, and request a refund.',
  },
  {
    q: 'Is my data stored on your servers?',
    a: 'No. Your content stays on your device. See each app’s privacy policy for the full details.',
  },
  {
    q: 'Which apps do you make?',
    a: 'Two right now: <a href="https://bronzed.cammstudios.com">Bronzed</a>, a tan timer built on the live UV index, and <a href="https://stellar.cammstudios.com">Stellar</a>, a daily affirmations and 369 journal app.',
  },
  {
    q: 'How do I contact you?',
    a: 'Email us at <a href="mailto:info@cammstudios.com">info@cammstudios.com</a>. We reply within 24 hours.',
  },
];
---

<CompanyShell
  title="Support — Camm Studios"
  description="Get help with Camm Studios apps: contact support, manage your subscription, restore purchases, and browse common questions."
>
  <div class="shell">
    <header class="page-head">
      <p class="kicker kicker--rule">Support</p>
      <h1 class="display-lg">How can we help?</h1>
    </header>

    <div class="support-grid">
      <div class="card pad">
        <h2>Email support</h2>
        <p>Questions, bugs, or ideas. We read everything and reply within 24 hours.</p>
        <a class="btn btn--primary btn--sm" href={`mailto:${company.email}`}>{company.email}</a>
      </div>
      <div class="card pad">
        <h2>Manage subscription</h2>
        <p>Cancel, change, or restore any subscription through your Apple Account settings.</p>
        <a class="btn btn--ghost btn--sm" href="https://apps.apple.com/account/subscriptions" rel="noopener">
          Open subscriptions
        </a>
      </div>
      <div class="card pad">
        <h2>App support pages</h2>
        <p>Looking for help with a specific app? Each app has its own support page.</p>
        <div class="row">
          {apps.map((app) => (
            <a class="btn btn--ghost btn--sm" href={`${app.site}/support`} rel="noopener">{app.name}</a>
          ))}
        </div>
      </div>
    </div>

    <section class="faq-wrap" aria-labelledby="faq-title">
      <h2 id="faq-title" class="display-md">Common questions</h2>
      <Faq items={faqs} />
    </section>
  </div>
</CompanyShell>

<style>
  .support-grid {
    display: grid;
    gap: var(--sp-300);
  }
  @media (min-width: 768px) {
    .support-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .pad {
    padding: var(--sp-400);
    display: grid;
    gap: var(--sp-200);
    align-content: start;
    justify-items: start;
    min-width: 0;
  }
  .pad :global(.btn) {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
    text-align: left;
  }
  .pad h2 { font-size: var(--text-xl); line-height: var(--lh-xl); }
  .pad p { color: var(--ink-soft); }
  .row { display: flex; gap: var(--sp-100); flex-wrap: wrap; }
  .faq-wrap { margin-top: var(--sp-800); max-width: 800px; }
  .faq-wrap h2 { margin-bottom: var(--sp-400); }
</style>
