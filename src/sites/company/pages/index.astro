---
import { Image, getImage } from 'astro:assets';
import Base from '@shared/layouts/Base.astro';
import SiteNav from '@shared/components/SiteNav.astro';
import SiteFooter from '@shared/components/SiteFooter.astro';
import WordReveal from '@shared/components/WordReveal.astro';
import Instruments from '@shared/components/Instruments.astro';
import { apps, company } from '@shared/data/apps';
import heroArt from '@shared/assets/art/company-hero.png';
import heroArtB from '@shared/assets/art/company-hero-b.png';
import craftArt from '@shared/assets/art/company-craft.png';
import bronzedArt from '@shared/assets/art/bronzed-hero.png';
import stellarArt from '@shared/assets/art/stellar-hero.png';
import bronzedIcon from '@shared/assets/icons/bronzed-icon.png';
import stellarIcon from '@shared/assets/icons/stellar-icon.png';

const heroBg = await getImage({ src: heroArt, format: 'avif', quality: 62, width: 2400 });
const heroBgB = await getImage({ src: heroArtB, format: 'avif', quality: 62, width: 2400 });
const missionArt = { bronzed: bronzedArt, stellar: stellarArt };
const icons = { bronzed: bronzedIcon, stellar: stellarIcon };

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Camm Studios',
    url: company.site,
    email: company.email,
    logo: `${company.site}/apple-touch-icon.png`,
    description:
      'Independent app studio. Small, sharp iOS apps for problems the big studios never notice.',
  },
  ...apps.map((app) => ({
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: app.storeName,
    operatingSystem: `iOS ${app.minimumOs} or later`,
    applicationCategory: 'LifestyleApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: app.site,
    installUrl: app.appStoreUrl,
    author: { '@type': 'Organization', name: 'Camm Studios' },
  })),
];

const bootLines = [
  { label: 'CAMM OS', state: 'v2.0' },
  { label: 'Artemis', state: 'hunting' },
  { label: 'Forge', state: 'ready' },
  { label: 'Sentinel', state: 'watching' },
  { label: 'All systems', state: 'nominal' },
];

const stages = [
  {
    no: '01',
    title: 'Hunt',
    body: 'Artemis mines App Store search data overnight and surfaces gems: searches with buying intent and weak competition. Each gem gets a one-page brief. Most briefs die right there. Day-one funerals are cheap.',
  },
  {
    no: '02',
    title: 'Forge',
    body: 'A green-lit brief goes to Forge, our app factory. Onboarding, paywall, analytics, and localization come stamped from a proven pattern in half a day. The build budget goes to the one feature that wins the niche.',
  },
  {
    no: '03',
    title: 'Launch',
    body: 'Ten working days is the budget from idea to submission. Apps ship in more than thirty languages, with store listings in 39 locales. Day one is worldwide.',
  },
  {
    no: '04',
    title: 'Operate',
    body: 'Every week, every app stands the same review: revenue, rankings, funnel. Winners get scaled. The rest get sixty days to prove themselves, then the archive. Every kill funds the next hunt.',
  },
];

const dials = [
  { n: '02', count: 2, pad: true, label: 'apps in orbit' },
  { n: '10', count: 10, pad: false, label: 'days, idea to submission' },
  { n: '39', count: 39, pad: false, label: 'store locales per launch' },
  { n: '∞', count: null, pad: false, label: 'overlooked problems left' },
];

const telemetry = [
  'Bronzed — tan smart, never burn',
  'Stellar — speak it, write it, see it',
  'Artemis is hunting',
  'Ten days, idea to App Store',
  'AI-native, human-judged',
];

const missionData = {
  bronzed: [
    ['Status', 'Launched · 2026'],
    ['Sector', 'Weather · Health'],
    ['Requires', 'iOS 18.0+'],
    ['Price', 'Free'],
  ],
  stellar: [
    ['Status', 'Launched · 2026'],
    ['Sector', 'Lifestyle · Health'],
    ['Requires', 'iOS 18.6+'],
    ['Price', 'Free'],
  ],
} as const;

const spy = [
  { id: 'window', label: 'Window' },
  { id: 'brief', label: 'Brief' },
  { id: 'sequence', label: 'Sequence' },
  { id: 'systems', label: 'Systems' },
  { id: 'missions', label: 'Missions' },
];
---

<Base
  title="Camm Studios — Small apps, done properly"
  description="Camm Studios is an independent app studio. We make small, sharp iOS apps for problems the big studios never notice. One job per app, done properly."
  jsonld={jsonld}
>
  <div class="boot" aria-hidden="true">
    <div class="boot-lines">
      {bootLines.map((line) => (
        <p class="bl">
          <span>{line.label}</span>
          <span class="ok">{line.state}</span>
        </p>
      ))}
    </div>
  </div>

  <SiteNav
    brandName="Camm Studios"
    items={[
      { label: 'Sequence', href: '/#sequence' },
      { label: 'Systems', href: '/#systems' },
      { label: 'Missions', href: '/#missions' },
      { label: 'Support', href: '/support' },
    ]}
    cta={{ label: 'Our apps', href: '/#missions' }}
    spy={spy}
  />

  <main id="main">
    <!-- 01 · observation window -->
    <section class="hero band--night" id="window" aria-label="Observation window">
      <div class="hero-bg living" aria-hidden="true">
        <img src={heroBg.src} alt="" class="hero-img" fetchpriority="high" />
        <img src={heroBgB.src} alt="" class="hero-img frame-b" loading="lazy" />
        <svg class="stars" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMin slice">
          {[
            [90, 80, 1.6, 0], [220, 180, 1.2, 1.3], [340, 60, 1.8, 2.1], [470, 140, 1.1, 0.6],
            [610, 90, 1.5, 2.8], [760, 200, 1.2, 1.9], [880, 70, 1.9, 0.4], [1010, 160, 1.3, 2.4],
            [1130, 100, 1.6, 1.1], [1260, 190, 1.2, 3.1], [1370, 80, 1.7, 0.8], [540, 250, 1.1, 3.6],
          ].map(([x, y, r, d]) => (
            <circle cx={x} cy={y} r={r} fill="#ffffff" style={`animation: twinkle ${3 + (d % 2)}s var(--ease-fluid) ${d}s infinite`} />
          ))}
        </svg>
        <svg class="reticle" viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="70" stroke="rgba(255,255,255,0.35)" stroke-width="1" stroke-dasharray="2 8" fill="none" />
          <circle cx="100" cy="100" r="3" fill="var(--accent-bright)" />
          <path d="M100 10 V40 M100 160 V190 M10 100 H40 M160 100 H190" stroke="rgba(255,255,255,0.35)" stroke-width="1" />
        </svg>
      </div>
      <div class="shell hero-frame" data-parallax="-0.05">
        <div class="plate hero-plate">
          <p class="kicker rise" style="--d: 200ms">
            <span class="module-id">[ 01 ]</span> Observation window · independent app studio
          </p>
          <h1 class="display-xl rise" style="--d: 340ms">The overlooked frontier.</h1>
          <p class="lede rise" style="--d: 500ms">
            We make small, sharp iOS apps for problems the big studios never notice. One job per
            app. Done properly.
          </p>
          <div class="hero-row rise" style="--d: 660ms">
            <a class="btn btn--primary" href="/#sequence">
              Read our process
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost" href="/#missions">Active missions</a>
          </div>
        </div>
      </div>
      <div class="marquee hero-marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...telemetry, ...telemetry].map((item) => (
            <span class="marquee-item">{item}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · the brief -->
    <section class="module band" id="brief" aria-labelledby="brief-title">
      <div class="shell">
        <p class="module-head">
          <span><span class="module-id">[ 02 ]</span> The brief</span>
          <span>Filed under: why we exist</span>
        </p>
        <div class="brief-grid">
          <h2 id="brief-title" class="display-lg ink-fade reveal">
            Giants need big problems.<br />We take everything<br />they leave behind.
          </h2>
          <div class="brief-note reveal" style="--reveal-delay: 120ms">
            <p class="lede">
              A tan timer. A nightly journal. Ideas too small for a boardroom, and exactly the
              right size for one person's day. Millions of people need tools like these, and most
              of what they get is junk. We think that is a business.
            </p>
            <p class="mono-note">— The founding brief, unchanged since day one</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 · mission sequence -->
    <section class="module band band--deep" id="sequence" aria-labelledby="seq-title">
      <div class="shell">
        <p class="module-head">
          <span><span class="module-id">[ 03 ]</span> Mission sequence</span>
          <span>Ten days, idea to submission</span>
        </p>
        <h2 id="seq-title" class="display-lg reveal">Hunt. Forge.<br />Launch. Operate.</h2>
        <div class="progressline seq-line" aria-hidden="true"><span></span></div>
        <ol class="stages">
          {stages.map((stage, i) => (
            <li class="stage reveal" style={`--reveal-delay: ${i * 100}ms`}>
              <p class="stage-no" aria-hidden="true">{stage.no}</p>
              <h3>{stage.title}</h3>
              <p class="stage-body">{stage.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 04 · systems -->
    <section class="module band band--night" id="systems" aria-labelledby="systems-title">
      <div class="shell">
        <p class="module-head">
          <span><span class="module-id">[ 04 ]</span> Systems</span>
          <span><span class="online-dot"></span> All online</span>
        </p>
        <h2 id="systems-title" class="display-lg ink-fade--night reveal">
          Proprietary instruments.
        </h2>
        <p class="lede reveal" style="--reveal-delay: 100ms">
          We build our own tools, and every tool has a name and one job. AI runs through all of
          them: reading markets overnight, drafting store pages in dozens of languages,
          stress-testing builds. It decides nothing. Every screen, every word, and every price
          still gets a human yes or no.
        </p>
        <Instruments />
        <ul class="dials" aria-label="Studio dials">
          {dials.map((dial) => (
            <li class="dial reveal">
              {dial.count !== null ? (
                <span class="dial-n" data-count={dial.count} data-pad={dial.pad ? '1' : ''}>
                  {dial.pad ? '00' : '0'}
                </span>
              ) : (
                <span class="dial-n">{dial.n}</span>
              )}
              <span class="mono-note">{dial.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 05 · observation -->
    <section class="module band" aria-label="Observation: the greenhouse">
      <div class="shell">
        <p class="module-head">
          <span><span class="module-id">[ 05 ]</span> Observation</span>
          <span>Assembly bay · tend the small things</span>
        </p>
        <div class="window obs-window reveal">
          <span class="wtick"></span>
          <div data-parallax="0.06">
            <Image
              src={craftArt}
              alt="A precision robotic arm assembling a palm-sized device under a single task light in a dark clean room"
              widths={[640, 1080, 1600, 2400]}
              sizes="100vw"
              format="avif"
              quality={60}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 06 · active missions -->
    <section class="module band" id="missions" aria-labelledby="missions-title">
      <div class="shell">
        <p class="module-head">
          <span><span class="module-id">[ 06 ]</span> Active missions</span>
          <span>02 in orbit</span>
        </p>
        <h2 id="missions-title" class="visually-hidden">Our apps</h2>
        <div class="missions">
          {apps.map((app, i) => (
            <article class={`mission ${i % 2 === 1 ? 'mission--flip' : ''}`}>
              <div class="window mission-window reveal">
                <span class="wtick"></span>
                <div data-parallax="0.045">
                  <Image
                    src={missionArt[app.id]}
                    alt=""
                    widths={[640, 1080, 1600]}
                    sizes="(min-width: 900px) 58vw, 100vw"
                    format="avif"
                    quality={58}
                  />
                </div>
              </div>
              <div class="mission-panel reveal" style="--reveal-delay: 120ms">
                <div class="mission-head">
                  <Image src={icons[app.id]} alt={`${app.name} app icon`} width={56} height={56} class="mission-icon" />
                  <p class="mono-note">Designation: {app.name.toUpperCase()}</p>
                </div>
                <h3 class="display-md">{app.tagline}</h3>
                <p class="mission-desc">{app.oneLiner}</p>
                <dl class="data-list">
                  {missionData[app.id].map(([k, v]) => (
                    <div>
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
                <div class="mission-actions">
                  <a class="btn btn--primary" href={app.site} rel="noopener">
                    Visit {app.name}
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                  <a class="btn btn--ghost" href={app.appStoreUrl} rel="noopener">App Store</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 07 · transmission -->
    <section class="module band band--deep" aria-label="Studio motto">
      <div class="shell">
        <p class="module-head">
          <span><span class="module-id">[ 07 ]</span> Transmission</span>
          <span>Repeats on every frequency</span>
        </p>
        <WordReveal class="display-lg motto" text="Small apps. Clear purpose. Built to get better." />
      </div>
    </section>
  </main>

  <SiteFooter
    columns={[
      { title: 'Apps', links: apps.map((app) => ({ label: app.name, href: app.site })) },
      {
        title: 'Studio',
        links: [
          { label: 'Sequence', href: '/#sequence' },
          { label: 'Systems', href: '/#systems' },
          { label: 'Support', href: '/support' },
        ],
      },
      {
        title: 'Legal',
        links: [
          { label: 'Privacy', href: '/privacy' },
          { label: 'Terms', href: '/terms' },
        ],
      },
    ]}
  />
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* 01 · observation window */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    overflow: clip;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    animation: drift-pan 44s var(--ease-fluid) infinite alternate;
  }
  .stars { position: absolute; inset: 0 0 auto 0; width: 100%; height: 60%; }
  .reticle {
    position: absolute;
    top: 16%;
    right: 12%;
    width: 180px;
    height: 180px;
    animation: float-y 9s var(--ease-fluid) infinite;
  }
  .hero-frame {
    position: relative;
    padding-bottom: var(--sp-500);
    display: grid;
    justify-items: start;
  }
  .hero-plate {
    max-width: 620px;
    display: grid;
    gap: var(--sp-300);
    justify-items: start;
  }
  .hero-plate .kicker { color: var(--night-soft); }
  .hero-plate h1 { color: var(--night-text); }
  .hero-plate .lede { color: color-mix(in srgb, var(--night-text) 88%, transparent); }
  .hero-row { display: flex; flex-wrap: wrap; gap: var(--sp-200); }
  .hero-marquee { position: relative; color: var(--night-soft); background: color-mix(in srgb, var(--night) 70%, transparent); }

  /* 02 · brief */
  .brief-grid { display: grid; gap: var(--sp-500); padding-block: var(--sp-600) var(--sp-400); }
  @media (min-width: 900px) {
    .brief-grid { grid-template-columns: 7fr 5fr; gap: var(--sp-800); align-items: end; }
  }
  .brief-note { display: grid; gap: var(--sp-300); max-width: 480px; }

  /* 03 · sequence */
  #sequence h2 { margin-block: var(--sp-400) var(--sp-600); }
  .seq-line { margin-bottom: var(--sp-500); }
  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-500);
  }
  @media (min-width: 900px) {
    .stages { grid-template-columns: repeat(4, 1fr); gap: var(--sp-400); }
  }
  .stage { display: grid; gap: var(--sp-200); align-content: start; }
  .stage-no {
    font-family: var(--font-mono);
    font-size: var(--text-5xl);
    line-height: 1;
    color: var(--accent);
  }
  .stage h3 {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .stage-body { color: var(--ink-soft); }

  /* 04 · systems */
  #systems h2 { margin-top: var(--sp-400); }
  #systems .lede { margin-top: var(--sp-300); }
  .online-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #79b979;
    animation: twinkle 2.6s var(--ease-fluid) infinite;
  }
  .dials {
    list-style: none;
    margin: var(--sp-700) 0 0;
    padding: var(--sp-400) 0 0;
    border-top: 1px solid var(--night-line);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-400);
  }
  @media (min-width: 900px) {
    .dials { grid-template-columns: repeat(4, 1fr); }
  }
  .dial { display: grid; gap: var(--sp-50); justify-items: start; }
  .dial-n {
    font-family: var(--font-mono);
    font-size: var(--text-4xl);
    line-height: var(--lh-4xl);
    color: var(--night-text);
  }

  /* 05 · observation */
  .obs-window :global(img) { width: 100%; height: auto; display: block; }

  /* 06 · missions */
  .missions { display: grid; gap: var(--sp-800); padding-block: var(--sp-400); }
  .mission { display: grid; gap: var(--sp-400); align-items: center; }
  @media (min-width: 900px) {
    .mission { grid-template-columns: 7fr 5fr; gap: var(--sp-600); }
    .mission--flip .mission-window { order: 2; }
    .mission--flip .mission-panel { order: 1; }
  }
  .mission-window :global(img) { width: 100%; height: auto; display: block; }
  .mission-panel { display: grid; gap: var(--sp-300); align-content: start; }
  .mission-head { display: flex; align-items: center; gap: var(--sp-200); }
  .mission-icon { border-radius: 12px; }
  .mission-desc { color: var(--ink-soft); max-width: 440px; }
  .mission-actions { display: flex; flex-wrap: wrap; gap: var(--sp-200); }

  .motto { max-width: 680px; margin-block: var(--sp-400); }
</style>
