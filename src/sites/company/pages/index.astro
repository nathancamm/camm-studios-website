---
import { Image, getImage } from 'astro:assets';
import Base from '@shared/layouts/Base.astro';
import SiteNav from '@shared/components/SiteNav.astro';
import SiteFooter from '@shared/components/SiteFooter.astro';
import WordReveal from '@shared/components/WordReveal.astro';
import Instruments from '@shared/components/Instruments.astro';
import Mark from '@shared/components/Mark.astro';
import { apps, company } from '@shared/data/apps';
import heroArt from '@shared/assets/art/company-hero.png';
import craftArt from '@shared/assets/art/company-craft.png';
import bronzedArt from '@shared/assets/art/bronzed-hero.png';
import stellarArt from '@shared/assets/art/stellar-hero.png';
import bronzedIcon from '@shared/assets/icons/bronzed-icon.png';
import stellarIcon from '@shared/assets/icons/stellar-icon.png';

const heroBg = await getImage({ src: heroArt, format: 'avif', quality: 62, width: 2400 });
const panelArt = { bronzed: bronzedArt, stellar: stellarArt };
const icons = { bronzed: bronzedIcon, stellar: stellarIcon };

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Camm Studios',
    url: company.site,
    email: company.email,
    logo: `${company.site}/apple-touch-icon.png`,
    description:
      'Independent app studio. We find overlooked problems and build focused apps that earn their place on your phone.',
  },
  ...apps.map((app) => ({
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: app.storeName,
    operatingSystem: `iOS ${app.minimumOs} or later`,
    applicationCategory: 'LifestyleApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: app.site,
    installUrl: app.appStoreUrl,
    author: { '@type': 'Organization', name: 'Camm Studios' },
  })),
];

const heroWords = ['The', 'overlooked', 'frontier.'];

const chapters = [
  {
    no: '01',
    title: 'Find',
    body: 'Most studios chase the charts. We ride the other way — into live store data, search trails, and one-star reviews, looking for the problems everyone else stepped past. If real people are searching and nobody serves them well, we stake the claim.',
  },
  {
    no: '02',
    title: 'Build',
    body: 'One problem, one app. Native SwiftUI, small on purpose: a tool you open, use, and put back in your pocket. If a screen does not serve the core job, it does not ship.',
  },
  {
    no: '03',
    title: 'Launch',
    body: 'Worldwide on day one. Store pages, screenshots, and copy tuned language by language — because somebody in Lisbon checks the UV index too.',
  },
  {
    no: '04',
    title: 'Tend',
    body: 'Software is a garden, not a monument. We watch how each app is really used, prune what fails to earn its place, and let the good parts grow. Every version comes back a little sharper.',
  },
];

const dials = [
  { n: '02', label: 'apps in orbit' },
  { n: '01', label: 'sun, measured daily' },
  { n: '18', label: 'intentions a day, the 369 way' },
  { n: '∞', label: 'overlooked problems left' },
];

const marquee = [
  'Bronzed — tan smart, never burn',
  'Stellar — speak it, write it, see it',
  'Independent app studio',
  'Launched worldwide',
  'AI-native, human-judged',
];
---

<Base
  title="Camm Studios — Focused apps for overlooked problems"
  description="Camm Studios is an independent app studio. We find the problems everyone rides past and build small, focused apps that earn their place on your phone."
  jsonld={jsonld}
>
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-inner">
      <Mark size={72} />
      <p class="intro-word">Camm Studios</p>
    </div>
  </div>

  <SiteNav
    brandName="Camm Studios"
    items={[
      { label: 'Process', href: '/#process' },
      { label: 'Instruments', href: '/#instruments' },
      { label: 'Apps', href: '/#apps' },
      { label: 'Support', href: '/support' },
    ]}
    cta={{ label: 'Our apps', href: '/#apps' }}
  />

  <main id="main">
    <!-- animated hero -->
    <section class="hero band--night">
      <div class="hero-bg" aria-hidden="true">
        <img src={heroBg.src} alt="" class="hero-img" fetchpriority="high" />
        <svg class="stars" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMin slice">
          {[
            [90, 80, 1.6, 0], [220, 180, 1.2, 1.3], [340, 60, 1.8, 2.1], [470, 140, 1.1, 0.6],
            [610, 90, 1.5, 2.8], [760, 200, 1.2, 1.9], [880, 70, 1.9, 0.4], [1010, 160, 1.3, 2.4],
            [1130, 100, 1.6, 1.1], [1260, 190, 1.2, 3.1], [1370, 80, 1.7, 0.8], [540, 250, 1.1, 3.6],
            [160, 280, 1.3, 2.6], [960, 280, 1.4, 1.6], [1320, 300, 1.1, 0.2],
          ].map(([x, y, r, d]) => (
            <circle cx={x} cy={y} r={r} fill="#f5f0e5" style={`animation: twinkle ${3 + (d % 2)}s var(--ease-fluid) ${d}s infinite`} />
          ))}
        </svg>
        <div class="hero-scrim"></div>
      </div>
      <div class="shell hero-content">
        <p class="kicker rise" style="--d: 200ms">Camm Studios — independent app studio</p>
        <h1 class="display-xl hero-title">
          {heroWords.map((word, i) => (
            <span class="rise" style={`--d: ${320 + i * 130}ms`}>{word} </span>
          ))}
        </h1>
        <p class="lede rise" style="--d: 780ms">
          We find the problems everyone rides past and build small, focused apps that earn their
          place on your phone.
        </p>
        <div class="hero-row rise" style="--d: 920ms">
          <a class="btn btn--primary" href="/#process">
            Read our process
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <p class="mono-note">Two apps in orbit, live on the App Store</p>
        </div>
      </div>
      <div class="marquee hero-marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...marquee, ...marquee].map((item) => (
            <span class="marquee-item">{item}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- manifesto -->
    <section class="band" aria-labelledby="manifesto-title">
      <div class="shell manifesto">
        <p class="kicker kicker--rule reveal">Why we exist</p>
        <h2 id="manifesto-title" class="display-lg ink-fade reveal">
          Giants need big problems.<br />We take everything<br />they leave behind.
        </h2>
        <p class="lede reveal" style="--reveal-delay: 100ms">
          The ideas we build look too small to matter — a tan timer, a nightly journal — until you
          meet the person who opens them every single day. That person is who we work for. We make
          small apps into serious businesses.
        </p>
      </div>
    </section>

    <!-- process: zigzag trajectory -->
    <section class="band band--deep" id="process" aria-labelledby="process-title">
      <div class="shell">
        <p class="kicker kicker--rule reveal">The operating model</p>
        <h2 id="process-title" class="display-lg reveal">Find. Build.<br />Launch. Tend.</h2>
        <div class="trajectory">
          {chapters.map((ch, i) => (
            <article class={`waypoint reveal ${i % 2 === 1 ? 'waypoint--right' : ''}`}>
              <p class="waypoint-no" aria-hidden="true">{ch.no}</p>
              <div class="waypoint-card card">
                <h3 class="display-md">{ch.title}</h3>
                <p>{ch.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- craft interlude -->
    <section class="interlude" aria-hidden="true">
      <div data-parallax="0.06">
        <Image
          src={craftArt}
          alt=""
          widths={[640, 1080, 1600, 2400]}
          sizes="100vw"
          format="avif"
          quality={60}
        />
      </div>
      <p class="interlude-caption mono-note shell">Fig. 02 — Tend the small things.</p>
    </section>

    <!-- instruments -->
    <section class="band band--night" id="instruments" aria-labelledby="instruments-title">
      <div class="shell">
        <p class="kicker kicker--rule reveal">AI-native, human-judged</p>
        <h2 id="instruments-title" class="display-lg ink-fade--night reveal">Our instruments.</h2>
        <p class="lede reveal" style="--reveal-delay: 100ms">
          Machines read the frontier at a scale no human could — demand, reviews, languages,
          numbers. Then a person picks up every result and asks the only question that matters:
          would this earn a place on your phone? AI proposes. We decide.
        </p>
        <Instruments />
        <ul class="dials" aria-label="Studio dials">
          {dials.map((dial) => (
            <li class="dial reveal">
              <span class="dial-n">{dial.n}</span>
              <span class="mono-note">{dial.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- portfolio panels -->
    <section id="apps" aria-labelledby="apps-title">
      <h2 id="apps-title" class="visually-hidden">Our apps</h2>
      {apps.map((app, i) => (
        <article class={`panel panel--${app.id}`}>
          <div class="shell panel-inner">
            <div class={`panel-copy reveal ${i % 2 === 1 ? 'panel-copy--right' : ''}`}>
              <div class="panel-head">
                <Image src={icons[app.id]} alt={`${app.name} app icon`} width={64} height={64} class="panel-icon" />
                <p class="kicker">{app.genres.join(' · ')} — iOS {app.minimumOs}+</p>
              </div>
              <h3 class="display-lg">{app.tagline}</h3>
              <p class="panel-desc">{app.oneLiner}</p>
              <div class="panel-actions">
                <a class="btn btn--primary" href={app.site} rel="noopener">
                  Visit {app.name}
                  <span class="btn-arrow" aria-hidden="true">→</span>
                </a>
                <a class="btn btn--ghost" href={app.appStoreUrl} rel="noopener">App Store</a>
              </div>
            </div>
          </div>
          <div class="panel-art" data-parallax="0.05">
            <Image
              src={panelArt[app.id]}
              alt=""
              widths={[640, 1080, 1600, 2400]}
              sizes="100vw"
              format="avif"
              quality={58}
            />
          </div>
        </article>
      ))}
    </section>

    <!-- tagline moment -->
    <section class="band band--deep" aria-label="Studio motto">
      <div class="shell">
        <WordReveal class="display-lg motto" text="Small apps. Clear purpose. Built to get better." />
      </div>
    </section>
  </main>

  <SiteFooter
    columns={[
      { title: 'Apps', links: apps.map((app) => ({ label: app.name, href: app.site })) },
      {
        title: 'Studio',
        links: [
          { label: 'Process', href: '/#process' },
          { label: 'Instruments', href: '/#instruments' },
          { label: 'Support', href: '/support' },
        ],
      },
      {
        title: 'Legal',
        links: [
          { label: 'Privacy', href: '/privacy' },
          { label: 'Terms', href: '/terms' },
        ],
      },
    ]}
  />
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* intro — once per session, skipped for reduced motion */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    transition: transform 900ms var(--ease-fluid), visibility 0s linear 900ms;
  }
  .intro-inner { display: grid; justify-items: center; gap: var(--sp-300); }
  .intro-inner :global(svg),
  .intro-word {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms var(--ease-fluid), transform 700ms var(--ease-fluid);
  }
  .intro-word {
    font-size: var(--text-2xl);
    line-height: var(--lh-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    transition-delay: 250ms;
  }
  html.intro-play .intro-inner :global(svg),
  html.intro-play .intro-word { opacity: 1; transform: translateY(0); }
  html.intro-done .intro { transform: translateY(-100%); visibility: hidden; }
  html.intro-off .intro { display: none; }

  /* hero */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100svh;
    overflow: clip;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    animation: drift-pan 44s var(--ease-fluid) infinite alternate;
  }
  .stars { position: absolute; inset: 0 0 auto 0; width: 100%; height: 60%; }
  .hero-scrim { position: absolute; inset: 0; }
  .hero-content {
    position: relative;
    display: grid;
    gap: var(--sp-300);
    justify-items: start;
    padding-top: calc(var(--sp-900) + var(--sp-500));
    padding-bottom: var(--sp-900);
  }
  .hero-scrim {
    background: linear-gradient(180deg, color-mix(in srgb, var(--night) 52%, transparent) 0%, transparent 55%);
  }
  .hero-title { max-width: 680px; color: var(--night-text); }
  .hero .kicker { color: color-mix(in srgb, var(--night-text) 80%, transparent); }
  .hero .lede { color: color-mix(in srgb, var(--night-text) 90%, transparent); }
  .hero-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-300); }
  .hero .mono-note { color: color-mix(in srgb, var(--night-text) 70%, transparent); }
  .hero-marquee { position: relative; color: var(--night-soft); }

  /* manifesto */
  .manifesto { display: grid; gap: var(--sp-300); }
  .manifesto .lede { max-width: 620px; }

  /* trajectory */
  .trajectory {
    margin-top: var(--sp-700);
    display: grid;
    gap: var(--sp-500);
    position: relative;
  }
  @media (min-width: 900px) {
    .trajectory {
      gap: var(--sp-700);
      background-image: linear-gradient(var(--line-strong) 33%, transparent 0);
      background-size: 1px 12px;
      background-repeat: repeat-y;
      background-position: 50% 0;
    }
  }
  .waypoint {
    position: relative;
    display: grid;
    gap: var(--sp-100);
  }
  @media (min-width: 900px) {
    .waypoint { width: calc(50% - var(--sp-500)); }
    .waypoint--right { justify-self: end; }
  }
  .waypoint-no {
    font-family: var(--font-mono);
    font-size: var(--text-5xl);
    line-height: 1;
    color: var(--orange);
  }
  .waypoint-card {
    padding: var(--sp-400);
    display: grid;
    gap: var(--sp-200);
  }
  .waypoint-card p { color: var(--ink-soft); }

  /* interlude */
  .interlude { overflow: clip; position: relative; }
  .interlude :global(img) { width: 100%; height: auto; }
  .interlude-caption { padding-block: var(--sp-100); }

  /* instruments band */
  #instruments h2 { margin-top: var(--sp-300); }
  #instruments .lede { margin-top: var(--sp-300); }

  .dials {
    list-style: none;
    margin: var(--sp-700) 0 0;
    padding: var(--sp-400) 0 0;
    border-top: 1px solid var(--night-line);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-400);
  }
  @media (min-width: 900px) {
    .dials { grid-template-columns: repeat(4, 1fr); }
  }
  .dial { display: grid; gap: var(--sp-50); justify-items: start; }
  .dial-n {
    font-family: var(--font-mono);
    font-size: var(--text-4xl);
    line-height: var(--lh-4xl);
    color: var(--night-text);
  }

  /* portfolio panels */
  .panel { overflow: clip; }
  .panel--bronzed { background: var(--paper-deep); }
  .panel--stellar { background: var(--night); color: var(--night-text); }
  .panel-inner { padding-block: var(--sp-800) 0; }
  .panel-copy { display: grid; gap: var(--sp-300); justify-items: start; max-width: 560px; }
  @media (min-width: 900px) {
    .panel-copy--right { justify-self: end; }
  }
  .panel-head { display: flex; align-items: center; gap: var(--sp-200); }
  .panel-icon { border-radius: 14px; }
  .panel--bronzed h3 { color: var(--orange-deep); }
  .panel--stellar h3 { color: #9fb0ff; }
  .panel-desc { font-size: var(--text-lg); line-height: var(--lh-lg); color: var(--ink-soft); max-width: 460px; }
  .panel--stellar .panel-desc { color: var(--night-soft); }
  .panel--stellar .kicker { color: var(--night-soft); }
  .panel-actions { display: flex; flex-wrap: wrap; gap: var(--sp-200); }
  .panel--stellar .btn--primary { background: var(--paper); color: var(--ink); }
  .panel--stellar .btn--ghost { border-color: var(--night-line); color: var(--night-text); }
  .panel-art { margin-top: var(--sp-600); }
  .panel-art :global(img) { width: 100%; height: auto; display: block; }

  .motto { max-width: 680px; }
</style>

<script>
  // Once-per-session intro. Never blocks reduced-motion users or return visits.
  const html = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = sessionStorage.getItem('cs-intro') === '1';
  if (reduced || seen) {
    html.classList.add('intro-off');
  } else {
    sessionStorage.setItem('cs-intro', '1');
    requestAnimationFrame(() => html.classList.add('intro-play'));
    window.setTimeout(() => html.classList.add('intro-done'), 1900);
  }
</script>
