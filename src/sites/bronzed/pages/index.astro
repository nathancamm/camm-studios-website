---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import AppShell from '@shared/components/AppShell.astro';
import AppStoreBadge from '@shared/components/AppStoreBadge.astro';
import WordReveal from '@shared/components/WordReveal.astro';
import Faq from '@shared/components/Faq.astro';
import { bronzed } from '@shared/data/apps';
import heroArt from '@shared/assets/art/bronzed-hero.png';
import shot01 from '@shared/assets/shots/bronzed-01.png';
import shot02 from '@shared/assets/shots/bronzed-02.png';
import shot03 from '@shared/assets/shots/bronzed-03.png';
import shot04 from '@shared/assets/shots/bronzed-04.png';
import shot05 from '@shared/assets/shots/bronzed-05.png';

const heroBg = await getImage({ src: heroArt, format: 'avif', quality: 60, width: 2200 });

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 1);

const features = [
  {
    kicker: 'Smart tan timer',
    title: 'A safe-time countdown, computed for you',
    body: 'Tell Bronzed your skin type once. Every session combines the live UV index, cloud cover, and the SPF you are wearing into one personal countdown — capped below your skin’s burn threshold, with a halfway flip reminder for an even tan.',
    shot: shot02,
    alt: 'Bronzed session screen showing UV index 7, skin type III, a 17 minute safe limit, and a guided 8 minute session',
  },
  {
    kicker: 'Live UV dashboard',
    title: 'Is now a good time? One glance answers it',
    body: 'A live UV gauge with color-coded risk, real-time conditions from Apple Weather, and hourly UV for the rest of the day. Home screen widgets keep the number in sight before you head out.',
    shot: shot03,
    alt: 'Bronzed home screen showing a live UV index of 7 with High UV label and hourly UV forecast',
  },
  {
    kicker: 'Lock Screen and Dynamic Island',
    title: 'Start a session, put your phone down',
    body: 'Your countdown, flip status, and sunscreen reapply alerts live on the Lock Screen and in the Dynamic Island. The timer keeps working while you relax — no unlocking, no checking.',
    shot: shot01,
    alt: 'Bronzed guided session timer showing 2 minutes 41 seconds remaining on the last round',
  },
  {
    kicker: 'Vitamin D tracking',
    title: 'Sunshine you can count',
    body: 'Bronzed estimates the vitamin D you produce in every session and tracks progress toward your daily goal, day by day and week by week.',
    shot: shot05,
    alt: 'Bronzed vitamin D screen showing 1,080 IU today against a 1,000 IU daily goal',
  },
  {
    kicker: 'Progress calendar',
    title: 'Watch your color build',
    body: 'Every session logs automatically. Streaks, totals, and weekly progress photos make the change impossible to miss — proof that smart, consistent sessions beat one long burn.',
    shot: shot04,
    alt: 'Bronzed progress calendar with a five day streak and weekly progress photos',
  },
];

const faqs = [
  {
    q: 'How does Bronzed know how long I can stay in the sun?',
    a: 'Bronzed combines the live UV index at your location, your Fitzpatrick skin type, and the SPF you are wearing. The calculation is based on Minimal Erythemal Dose (MED) — the same model dermatologists use — and every safe time is capped below your skin’s burn threshold with a built-in safety margin.',
  },
  {
    q: 'Is tanning ever completely safe?',
    a: 'No — and Bronzed will never tell you otherwise. All UV exposure carries some risk. Bronzed exists to make your time in the sun informed and deliberate: personal limits, flip reminders, and SPF guidance instead of guesswork. Stop immediately if your skin shows any sign of burning, whatever the timer says.',
  },
  {
    q: 'Does it work without location access?',
    a: 'Yes. Location (“while using”) gives you accurate local UV automatically, but you can also enter any location manually.',
  },
  {
    q: 'Where does the weather data come from?',
    a: 'UV index, temperature, and forecasts come from Apple Weather, the same source as the built-in Weather app.',
  },
  {
    q: 'Is Bronzed free?',
    a: 'Bronzed is free to download and use. A premium subscription unlocks the full guided routine: $39.99/year (with a 3-day free trial) or $6.99/week. Cancel anytime in your Apple Account settings.',
  },
  {
    q: 'Where is my data stored?',
    a: 'On your device. Your skin profile, session history, and progress photos never leave your phone. See the <a href="/privacy">privacy policy</a> for details.',
  },
  {
    q: 'Does Bronzed work for darker skin types?',
    a: 'Yes. Bronzed supports all six Fitzpatrick skin types, and the plans differ dramatically — fair skin that burns in minutes and deep skin that rarely burns get completely different safe times, because that is how sun actually works.',
  },
  {
    q: 'Is Bronzed a medical app?',
    a: 'No. Bronzed provides estimates and general guidance, not medical advice. If you have fair or sensitive skin, a history of skin cancer, or take medication that increases sun sensitivity, talk to a doctor before deliberate sun exposure.',
  },
];
---

<AppShell
  app={bronzed}
  title="Bronzed — Tan smart, never burn. Personal tan timer & live UV index"
  description="Bronzed calculates your personal safe tanning time from the live UV index, your skin type, and your SPF. Free on the App Store."
>
  <main id="main">
    <!-- hero -->
    <section class="hero band--night" style={`background-image: url(${heroBg.src})`}>
      <div class="hero-scrim"></div>
      <svg class="sun-rings" viewBox="0 0 600 600" aria-hidden="true">
        <g class="rings-spin">
          <circle cx="300" cy="300" r="150" stroke="rgba(245,240,229,0.35)" stroke-width="1.2" stroke-dasharray="2 10" fill="none" />
          <circle cx="300" cy="300" r="210" stroke="rgba(245,240,229,0.22)" stroke-width="1" stroke-dasharray="2 14" fill="none" />
          <circle cx="300" cy="300" r="272" stroke="rgba(245,240,229,0.14)" stroke-width="1" stroke-dasharray="2 18" fill="none" />
        </g>
        <circle class="ring-glow" cx="300" cy="300" r="90" fill="rgba(228,87,26,0.18)" />
      </svg>
      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="kicker rise" style="--d: 150ms">Bronzed — Tan timer &amp; UV index</p>
          <h1 class="display-xl ink-fade--night">
            <span class="rise" style="--d: 280ms">Tan smart,</span><br />
            <span class="rise" style="--d: 420ms">never burn.</span>
          </h1>
          <p class="lede rise" style="--d: 580ms">
            Your skin, the live UV index, and your SPF — turned into one number: how long you can
            stay in the sun today.
          </p>
          <div class="hero-cta rise" style="--d: 720ms">
            <AppStoreBadge href={bronzed.appStoreUrl} tone="paper" />
            <p class="mono-note">iOS {bronzed.minimumOs}+ · Powered by Apple Weather</p>
          </div>
        </div>
        <div class="hero-shot rise" style="--d: 860ms">
          <div data-parallax="0.06">
            <Image
              src={shot01}
              alt="Bronzed app guided tanning session with a personal countdown timer"
              widths={[320, 480, 640]}
              sizes="(min-width: 900px) 380px, 70vw"
              format="avif"
              quality={70}
              loading="eager"
              class="shot-img"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- features -->
    <section class="band" id="features" aria-labelledby="features-title">
      <div class="shell">
        <p class="kicker kicker--rule reveal">What it does</p>
        <h2 id="features-title" class="display-lg reveal">
          The math for<br />your skin.
        </h2>
        <div class="feature-list">
          {features.map((f, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--flip' : ''}`}>
              <div class="feature-copy reveal">
                <p class="index-no">{String(i + 1).padStart(2, '0')}</p>
                <p class="kicker">{f.kicker}</p>
                <h3 class="display-md">{f.title}</h3>
                <p class="feature-body">{f.body}</p>
              </div>
              <div class="feature-shot reveal" style="--reveal-delay: 100ms">
                <Image
                  src={f.shot}
                  alt={f.alt}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 900px) 400px, 80vw"
                  format="avif"
                  quality={70}
                  class="shot-img"
                />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- how it works -->
    <section class="band band--deep" aria-labelledby="how-title">
      <div class="shell">
        <p class="kicker kicker--rule reveal">How it works</p>
        <h2 id="how-title" class="display-lg reveal">Three steps, then sun.</h2>
        <ol class="steps">
          {[
            {
              t: 'Tell it your skin, once',
              d: 'Pick your Fitzpatrick skin type in onboarding. Bronzed handles every calculation from there.',
            },
            {
              t: 'Check the gauge',
              d: 'The live UV dashboard tells you whether now is a good time and which SPF to wear.',
            },
            {
              t: 'Start your session',
              d: 'A personal countdown with flip and reapply reminders runs on your Lock Screen while you relax.',
            },
          ].map((step, i) => (
            <li class="step reveal" style={`--reveal-delay: ${i * 80}ms`}>
              <p class="index-no">{String(i + 1).padStart(2, '0')}</p>
              <h3>{step.t}</h3>
              <p>{step.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- tagline moment -->
    <section class="band" aria-label="Why Bronzed exists">
      <div class="shell">
        <WordReveal
          class="display-lg motto"
          text="Fair skin burns in minutes. Olive skin rarely does. One timer for everyone was always wrong."
        />
      </div>
    </section>

    <!-- science + privacy -->
    <section class="band band--night" aria-labelledby="science-title">
      <div class="shell">
        <p class="kicker kicker--rule reveal">Built on real science</p>
        <h2 id="science-title" class="display-lg ink-fade--night reveal">
          The model dermatologists use.
        </h2>
        <div class="science-grid">
          <div class="science-item reveal">
            <h3>Fitzpatrick + MED</h3>
            <p>
              Safe times come from the Fitzpatrick skin type scale and Minimal Erythemal Dose — the
              standard model for how skin responds to UV. Every calculation is capped below your
              burn threshold.
            </p>
          </div>
          <div class="science-item reveal" style="--reveal-delay: 70ms">
            <h3>Honest by design</h3>
            <p>
              There is no such thing as risk-free tanning, and Bronzed never pretends otherwise. It
              makes sun time informed and deliberate, with SPF guidance and hard stops.
            </p>
          </div>
          <div class="science-item reveal" style="--reveal-delay: 140ms">
            <h3>Private by default</h3>
            <p>
              Your skin profile, sessions, and photos stay on your device. We never see them.
              Anonymous usage analytics only — read the <a href="/privacy">privacy policy</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- faq -->
    <section class="band" id="faq" aria-labelledby="faq-title">
      <div class="shell faq-shell">
        <p class="kicker kicker--rule reveal">Questions</p>
        <h2 id="faq-title" class="display-lg reveal">Before you ask</h2>
        <Faq items={faqs} />
      </div>
    </section>

    <!-- blog preview -->
    {posts.length > 0 && (
      <section class="band band--deep" aria-labelledby="blog-title">
        <div class="shell">
          <p class="kicker kicker--rule reveal">From the blog</p>
          <h2 id="blog-title" class="display-lg reveal">Sun, explained.</h2>
          <div class="blog-grid">
            {posts.map((post) => (
              <a class="card blog-card reveal" href={`/blog/${post.id}`}>
                <Image
                  src={post.data.hero}
                  alt={post.data.heroAlt}
                  widths={[480, 760, 1080]}
                  sizes="(min-width: 900px) 760px, 100vw"
                  format="avif"
                  quality={60}
                  class="blog-img"
                />
                <div class="blog-copy">
                  <p class="mono-note">
                    {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </p>
                  <h3>{post.data.title}</h3>
                  <p class="blog-summary">{post.data.summary}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- final CTA -->
    <section class="band band--night cta-final" aria-labelledby="cta-title">
      <div class="shell cta-inner">
        <h2 id="cta-title" class="display-lg ink-fade--night reveal">
          The sun is out.<br />Know your number.
        </h2>
        <div class="reveal" style="--reveal-delay: 100ms">
          <AppStoreBadge href={bronzed.appStoreUrl} tone="paper" />
        </div>
        <p class="mono-note reveal" style="--reveal-delay: 160ms">
          Free download · Premium from $39.99/year with a 3-day trial
        </p>
      </div>
    </section>
  </main>
</AppShell>

<style>
  .hero {
    position: relative;
    background-size: cover;
    background-position: center 30%;
    padding-top: calc(var(--sp-900) + var(--sp-600));
    padding-bottom: var(--sp-800);
    overflow: clip;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--night) 44%, transparent);
  }
  .sun-rings {
    position: absolute;
    right: -8%;
    top: 4%;
    width: min(720px, 70vw);
    height: auto;
    pointer-events: none;
  }
  .rings-spin { transform-origin: 300px 300px; animation: spin-slow 60s linear infinite; }
  .ring-glow { transform-origin: 300px 300px; animation: glow-pulse 6s var(--ease-fluid) infinite; }
  .hero-inner {
    position: relative;
    display: grid;
    gap: var(--sp-600);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.2fr 0.8fr; }
  }
  .hero-copy { display: grid; gap: var(--sp-300); justify-items: start; }
  .hero-cta { display: grid; gap: var(--sp-200); justify-items: start; }
  .hero .kicker { color: var(--night-text); }
  .hero .lede { color: color-mix(in srgb, var(--night-text) 88%, transparent); }
  .hero .mono-note { color: color-mix(in srgb, var(--night-text) 72%, transparent); }
  .hero-shot { justify-self: center; }
  .hero-shot :global(.shot-img) {
    width: min(340px, 70vw);
    border-radius: 32px;
    transform: rotate(2.5deg);
    box-shadow: 0 48px 96px -32px color-mix(in srgb, var(--night) 80%, transparent);
  }

  .feature-list { margin-top: var(--sp-700); display: grid; gap: var(--sp-800); }
  .feature {
    display: grid;
    gap: var(--sp-400);
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: var(--sp-600);
  }
  @media (min-width: 900px) {
    .feature { grid-template-columns: 1fr 1fr; gap: var(--sp-800); }
    .feature--flip .feature-copy { order: 2; }
    .feature--flip .feature-shot { order: 1; }
  }
  .feature-copy { display: grid; gap: var(--sp-200); }
  .feature-body { color: var(--ink-soft); max-width: 480px; font-size: var(--text-lg); line-height: var(--lh-lg); }
  .feature-shot { justify-self: center; }
  .feature-shot :global(.shot-img) {
    width: min(400px, 80vw);
    border-radius: 24px;
    border: 1px solid var(--line);
  }

  .steps {
    list-style: none;
    margin: var(--sp-700) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-400);
  }
  @media (min-width: 768px) {
    .steps { grid-template-columns: repeat(3, 1fr); }
  }
  .step {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: var(--sp-400);
    display: grid;
    gap: var(--sp-100);
    align-content: start;
  }
  .step h3 { font-size: var(--text-xl); line-height: var(--lh-xl); }
  .step p:last-child { color: var(--ink-soft); }

  .motto { max-width: 680px; }

  .science-grid {
    margin-top: var(--sp-700);
    display: grid;
    gap: var(--sp-400);
  }
  @media (min-width: 768px) {
    .science-grid { grid-template-columns: repeat(3, 1fr); gap: var(--sp-500); }
  }
  .science-item { border-top: 1px solid var(--night-line); padding-top: var(--sp-300); }
  .science-item h3 { font-size: var(--text-xl); line-height: var(--lh-xl); }
  .science-item p { margin-top: var(--sp-100); color: var(--night-soft); }
  .science-item a { color: var(--night-text); }

  .faq-shell { max-width: 800px; }
  .faq-shell h2 { margin-bottom: var(--sp-500); }

  .blog-grid { margin-top: var(--sp-600); display: grid; }
  .blog-card {
    text-decoration: none;
    overflow: hidden;
    display: grid;
    transition: transform 700ms var(--ease-fluid), box-shadow 700ms var(--ease-fluid);
  }
  @media (min-width: 900px) {
    .blog-card { grid-template-columns: 1fr 1fr; align-items: center; }
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -24px color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .blog-card :global(.blog-img) { width: 100%; height: 100%; object-fit: cover; }
  .blog-copy { padding: var(--sp-400); display: grid; gap: var(--sp-200); }
  .blog-copy h3 { font-size: var(--text-2xl); line-height: var(--lh-2xl); }
  .blog-summary { color: var(--ink-soft); }

  .cta-inner {
    display: grid;
    gap: var(--sp-400);
    justify-items: center;
    text-align: center;
  }
</style>
