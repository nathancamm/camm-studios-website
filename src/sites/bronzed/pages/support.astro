---
import AppShell from '@shared/components/AppShell.astro';
import Faq from '@shared/components/Faq.astro';
import { bronzed, company } from '@shared/data/apps';

const faqs = [
  {
    q: 'The UV index looks wrong for my location',
    a: 'Bronzed uses Apple Weather. Check that Location Services are enabled for Bronzed (“While Using”), or set your location manually from the home screen. UV can also change quickly with cloud cover.',
  },
  {
    q: 'How do I change my skin type or SPF?',
    a: 'Open <strong>Profile → Skin type</strong> to update your Fitzpatrick type, and pick your SPF at the start of each session. Your safe time recalculates instantly.',
  },
  {
    q: 'How do I cancel my subscription?',
    a: 'Open the <strong>Settings</strong> app on your iPhone, tap your name, then <strong>Subscriptions</strong>, choose Bronzed, and tap <strong>Cancel Subscription</strong>.',
  },
  {
    q: 'How do I restore my purchase on a new device?',
    a: 'Open Bronzed, go to <strong>Settings</strong>, and tap <strong>Restore Purchases</strong>. Sign in with the same Apple Account you used for the original purchase.',
  },
  {
    q: 'Can I get a refund?',
    a: 'Refunds are handled by Apple. Visit <a href="https://reportaproblem.apple.com" rel="noopener">reportaproblem.apple.com</a>, sign in, find the purchase, and request a refund.',
  },
  {
    q: 'Is my data stored on your servers?',
    a: 'No. Your skin profile, session history, and progress photos stay on your device. Deleting the app deletes them. See the <a href="/privacy">privacy policy</a>.',
  },
];
---

<AppShell
  app={bronzed}
  title="Support — Bronzed"
  description="Get help with Bronzed: UV data, skin types, subscriptions, refunds, and privacy."
>
  <main id="main" class="subpage">
    <div class="shell">
      <header class="page-head">
        <p class="kicker kicker--rule">Support</p>
        <h1 class="display-lg">Here to help.</h1>
        <p class="lede">
          Most questions are answered below. For anything else, email us — we reply within 24
          hours.
        </p>
      </header>
      <div class="actions">
        <a class="btn btn--primary" href={`mailto:${company.email}?subject=Bronzed%20support`}>
          {company.email}
        </a>
        <a class="btn btn--ghost" href="https://apps.apple.com/account/subscriptions" rel="noopener">
          Manage subscription
        </a>
      </div>
      <section class="faq-wrap" aria-label="Frequently asked questions">
        <Faq items={faqs} />
      </section>
    </div>
  </main>
</AppShell>

<style>
  .subpage { padding-top: calc(var(--sp-900) + var(--sp-500)); padding-bottom: var(--sp-900); }
  .page-head { display: grid; gap: var(--sp-200); margin-bottom: var(--sp-400); }
  .actions { display: flex; gap: var(--sp-200); flex-wrap: wrap; margin-bottom: var(--sp-700); }
  .faq-wrap { max-width: 800px; }
</style>
