---
import { Image } from 'astro:assets';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Nav from '@shared/components/Nav.astro';
import Footer from '@shared/components/Footer.astro';
import ThreeScene from '@shared/components/ThreeScene.astro';
import SystemCard from '@shared/components/SystemCard.astro';
import mark from '@shared/assets/brand/concepts/vertebra-lock.webp';
import bronzedIcon from '@shared/assets/product/bronzed-icon.png';
import stellarIcon from '@shared/assets/product/stellar-icon.png';
import bronzedPortalArt from '@shared/assets/art/products/bronzed-solar-symbol.webp';
import stellarPortalArt from '@shared/assets/art/products/stellar-star-symbol.webp';
import artemisArt from '@shared/assets/art/systems/artemis-signal-bow.webp';
import atlasArt from '@shared/assets/art/systems/atlas-orbit-stack.webp';
import morpheusArt from '@shared/assets/art/systems/morpheus-dream-ribbon.webp';
import chronosArt from '@shared/assets/art/systems/chronos-cadence-ring.webp';
import { companySite } from '@shared/data/site';
import '@shared/styles/company.css';

const canonical = new URL('/', Astro.site);
const socialImage = new URL(mark.src, Astro.site);
const products = {
  bronzed: {
    name: 'Bronzed',
    appStoreTitle: 'Bronzed — Tan Timer & UV Index',
    url: 'https://bronzed.cammstudios.com',
    icon: bronzedIcon,
    portalArt: bronzedPortalArt,
  },
  stellar: {
    name: 'Stellar',
    appStoreTitle: 'Stellar — Mantra & Ritual',
    url: 'https://stellar.cammstudios.com',
    icon: stellarIcon,
    portalArt: stellarPortalArt,
  },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: companySite.name,
  url: companySite.url,
  logo: socialImage.toString(),
  email: companySite.email,
  description: companySite.description,
  owns: Object.values(products).map((app) => ({
    '@type': 'MobileApplication',
    name: app.appStoreTitle,
    url: app.url,
  })),
};

const operatingLoop = [
  {
    number: '01',
    title: 'Research the store',
    body: 'Ideas start in App Store data. Artemis scans search terms and categories to find demand that existing apps serve poorly.',
  },
  {
    number: '02',
    title: 'Validate before building',
    body: 'An idea becomes a brief only when searches, reviews, and the competition all say the need is real.',
  },
  {
    number: '03',
    title: 'Build small and native',
    body: 'Each app is built in SwiftUI around one core job, with privacy as a default rather than an afterthought.',
  },
  {
    number: '04',
    title: 'Operate and improve',
    body: 'Atlas gathers sales, subscriptions, advertising, and review data nightly. That data decides what gets improved next.',
  },
];

const systems = [
  {
    name: 'Artemis',
    role: 'Keyword research',
    kind: 'artemis' as const,
    art: artemisArt,
    description: 'A command line tool that mines App Store search data to surface niches where demand outpaces the apps serving it.',
  },
  {
    name: 'Atlas',
    role: 'Studio data',
    kind: 'atlas' as const,
    art: atlasArt,
    description: 'One database that collects sales, subscriptions, advertising, attribution, and analytics for every app, every night.',
  },
  {
    name: 'Morpheus',
    role: 'Creative production',
    kind: 'morpheus' as const,
    art: morpheusArt,
    status: 'In development',
    description: 'A pipeline for producing marketing creative and App Store assets without a design team.',
  },
  {
    name: 'Chronos',
    role: 'Studio planning',
    kind: 'chronos' as const,
    art: chronosArt,
    description: 'Turns the studio backlog into daily and weekly plans, so limited hours go where they matter most.',
  },
];

const questions = [
  ['What is Camm Studios?', 'An independent app studio run by a single developer. It designs, builds, and operates its own iOS apps rather than working for clients.'],
  ['What apps are live?', 'Bronzed, a tan timer and UV index app, and Stellar, a daily affirmations and journaling app. Both are on the App Store.'],
  ['Is Camm Studios an agency?', 'No. The studio builds and operates its own products only. It does not take client or contract work.'],
  ['How are new apps chosen?', 'By evidence. The studio looks for App Store searches that current apps answer poorly, and only builds when the demand shows up in the data.'],
  ['How does the studio use AI?', 'For research, prototyping, and the repetitive parts of shipping. Product decisions, releases, and support are handled by a person.'],
  ['Where do I get product support?', 'Each app has its own site with a support page. Follow the product links below, or email info@cammstudios.com.'],
];
---

<BaseLayout
  title="Camm Studios — Independent iOS app studio"
  description="Camm Studios is an independent studio building small, focused iOS apps. Bronzed and Stellar are live on the App Store."
  canonical={canonical}
  image={socialImage}
  structuredData={structuredData}
>
  <Nav links={[{ href: '#operate', label: 'How it works' }, { href: '#systems', label: 'Systems' }, { href: '#apps', label: 'Apps' }]} />
  <main id="main">
    <section class="company-hero shell">
      <div class="company-hero__copy">
        <p class="eyebrow" data-reveal>Independent iOS app studio</p>
        <h1 data-word-reveal>A one person studio building focused iOS apps.</h1>
        <p class="company-hero__lede" data-reveal>Camm Studios finds everyday problems that bigger teams overlook, then builds small native apps that solve them well. Two are live on the App Store today.</p>
        <div class="company-hero__actions" data-reveal>
          <a class="button button--light" href="#apps">See the apps</a>
          <p><span>Live now</span><a href="https://bronzed.cammstudios.com">Bronzed</a><a href="https://stellar.cammstudios.com">Stellar</a></p>
        </div>
      </div>
      <div class="company-hero__object">
        <ThreeScene
          scene="monogram"
          label="The Camm Studios monogram: a translucent robotic serpent coiled into the letter C, with dark servo joints and a camera eye"
          poster={mark}
          accent="#ffffff"
        />
        <div class="object-index" aria-hidden="true"><span>CAMM MONOGRAM / 001</span><span>GLASS SERPENT</span></div>
      </div>
    </section>

    <section class="reading-moment shell" aria-labelledby="company-thesis">
      <p class="eyebrow">How the studio thinks</p>
      <h2 id="company-thesis" data-reading-reveal>Find a real problem. Build the smallest app that solves it well. Keep improving it. Repeat.</h2>
    </section>

    <section class="operate-section" id="operate" aria-labelledby="operate-title">
      <div class="shell operate-section__layout">
        <header class="operate-section__intro">
          <p class="eyebrow">How it works / 01</p>
          <h2 id="operate-title">One loop.<br />Every app.</h2>
          <p>There is no big team here. There is a repeatable loop, run carefully, one app at a time.</p>
        </header>
        <div class="operating-loop">
          {operatingLoop.map((step) => (
            <article class="loop-step" data-reveal>
              <p class="loop-step__number">{step.number}</p>
              <div><h3>{step.title}</h3><p>{step.body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="judgment-section">
      <div class="shell judgment-section__layout">
        <p class="eyebrow">The honest part / 02</p>
        <h2 data-reading-reveal>AI does the busywork. One person makes the calls.</h2>
        <div class="judgment-section__body" data-reveal>
          <p>Modern tools write code, draft copy, and crunch store data far faster than any solo developer could alone.</p>
          <p>Every feature, price, and release still gets decided by a human who uses these apps daily.</p>
        </div>
      </div>
    </section>

    <section class="systems-section shell" id="systems" aria-labelledby="systems-title">
      <header class="section-heading">
        <p class="eyebrow">Studio systems / 03</p>
        <h2 id="systems-title">The tools behind the products.</h2>
        <p>Running a portfolio solo only works with good tooling. These are the internal systems that keep the studio moving.</p>
      </header>
      <div class="systems-grid">
        {systems.map((system) => <SystemCard {...system} />)}
      </div>
    </section>

    <section class="apps-section" id="apps" aria-labelledby="apps-title">
      <div class="shell">
        <header class="section-heading section-heading--wide">
          <p class="eyebrow">Live products / 04</p>
          <h2 id="apps-title">Two problems.<br />Two focused apps.</h2>
        </header>
        <div class="apps-grid">
          <a class="app-portal app-portal--bronzed" href="https://bronzed.cammstudios.com" data-reveal>
            <div class="app-portal__top"><span>Tan timer and UV index</span><span>↗</span></div>
            <div class="app-portal__identity"><Image src={products.bronzed.icon} alt="Bronzed app icon" width={128} height={128} format="webp" /><h3>Bronzed</h3></div>
            <p>Live UV, your skin type, and SPF, turned into a practical timer for time in the sun.</p>
            <Image class="app-portal__art" src={products.bronzed.portalArt} alt="" width={1024} quality={88} loading="lazy" aria-hidden="true" />
          </a>
          <a class="app-portal app-portal--stellar" href="https://stellar.cammstudios.com" data-reveal>
            <div class="app-portal__top"><span>Affirmations and journaling</span><span>↗</span></div>
            <div class="app-portal__identity"><Image src={products.stellar.icon} alt="Stellar app icon" width={128} height={128} format="webp" /><h3>Stellar</h3></div>
            <p>Affirmations, 369 journaling, and vision boards in one private daily ritual.</p>
            <Image class="app-portal__art" src={products.stellar.portalArt} alt="" width={1024} quality={88} loading="lazy" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section class="company-faq shell" aria-labelledby="company-faq-title">
      <header class="section-heading">
        <p class="eyebrow">Questions / 05</p>
        <h2 id="company-faq-title">Straight answers about the studio.</h2>
      </header>
      <div class="faq-list">
        {questions.map(([question, answer], index) => (
          <details data-reveal>
            <summary><span>0{index + 1}</span>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="company-close shell">
      <p class="eyebrow">Two apps, live today</p>
      <h2>Start with the app<br />that fits your day.</h2>
      <div><a class="button button--light" href="https://bronzed.cammstudios.com">Explore Bronzed</a><a class="button" href="https://stellar.cammstudios.com">Explore Stellar</a></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
