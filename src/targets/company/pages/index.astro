---
import { Image } from 'astro:assets';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Nav from '@shared/components/Nav.astro';
import Footer from '@shared/components/Footer.astro';
import ThreeScene from '@shared/components/ThreeScene.astro';
import SystemCard from '@shared/components/SystemCard.astro';
import mark from '@shared/assets/brand/concepts/vertebra-lock.webp';
import snakeModel from '@shared/assets/models/camm-robotic-snake.glb?url';
import bronzedIcon from '@shared/assets/product/bronzed-icon.png';
import stellarIcon from '@shared/assets/product/stellar-icon.png';
import bronzedPortalArt from '@shared/assets/art/products/bronzed-instrument.webp';
import stellarPortalArt from '@shared/assets/art/products/stellar-instrument.webp';
import artemisArt from '@shared/assets/art/systems/artemis.webp';
import atlasArt from '@shared/assets/art/systems/atlas.webp';
import morpheusArt from '@shared/assets/art/systems/morpheus.webp';
import chronosArt from '@shared/assets/art/systems/chronos.webp';
import { companySite } from '@shared/data/site';
import '@shared/styles/company.css';

const canonical = new URL('/', Astro.site);
const socialImage = new URL(mark.src, Astro.site);
const products = {
  bronzed: {
    name: 'Bronzed',
    appStoreTitle: 'Bronzed — Tan Timer & UV Index',
    url: 'https://bronzed.cammstudios.com',
    icon: bronzedIcon,
    portalArt: bronzedPortalArt,
  },
  stellar: {
    name: 'Stellar',
    appStoreTitle: 'Stellar — Mantra & Ritual',
    url: 'https://stellar.cammstudios.com',
    icon: stellarIcon,
    portalArt: stellarPortalArt,
  },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: companySite.name,
  url: companySite.url,
  logo: socialImage.toString(),
  email: companySite.email,
  description: companySite.description,
  owns: Object.values(products).map((app) => ({
    '@type': 'MobileApplication',
    name: app.appStoreTitle,
    url: app.url,
  })),
};

const operatingLoop = [
  {
    number: '01',
    title: 'Find the signal',
    body: 'We study store searches, reviews, category gaps, and recurring friction. The goal is a problem people already try to solve.',
  },
  {
    number: '02',
    title: 'Prove the need',
    body: 'We test whether the problem is clear, recurring, and suited to a focused product before adding scope.',
  },
  {
    number: '03',
    title: 'Build the useful part',
    body: 'We shape one native experience around the strongest need. Privacy, clarity, and local context are product decisions.',
  },
  {
    number: '04',
    title: 'Keep learning',
    body: 'Once the product is live, product, store, and support signals show us what to improve and what to remove.',
  },
];

const systems = [
  {
    name: 'Artemis',
    role: 'Opportunity discovery',
    kind: 'artemis' as const,
    art: artemisArt,
    description: 'Collects App Store search and category signals for human review, helping us investigate overlooked consumer problems.',
  },
  {
    name: 'Atlas',
    role: 'Portfolio intelligence',
    kind: 'atlas' as const,
    art: atlasArt,
    description: 'Brings store, subscription, advertising, attribution, and product data together for portfolio decisions.',
  },
  {
    name: 'Morpheus',
    role: 'Creative production',
    kind: 'morpheus' as const,
    art: morpheusArt,
    status: 'In development',
    description: 'Structures short form creative work from brief through generation, review, and learning. Publishing stays human approved.',
  },
  {
    name: 'Chronos',
    role: 'Operating cadence',
    kind: 'chronos' as const,
    art: chronosArt,
    description: 'Turns studio tasks into daily and weekly plans, then improves time estimates from completed work.',
  },
];

const questions = [
  ['What does Camm Studios build?', 'We build and operate focused consumer apps. Each product lives on its own site with product details, support, guides, privacy information, and App Store access.'],
  ['How do you choose what to build?', 'We start with evidence from search behaviour, reviews, category gaps, and recurring consumer friction. A promising signal still needs human judgment before it becomes a product.'],
  ['Is Camm Studios a client agency?', 'Our focus is building and improving our own app portfolio. The company site explains that operating model rather than offering development services.'],
  ['How does the studio use AI?', 'AI helps us search wider, prototype faster, and reduce repetitive work. People decide what is useful, responsible, clear, and ready to ship.'],
  ['What are the internal systems?', 'Artemis, Atlas, Morpheus, and Chronos are tools we use or are developing for opportunity discovery, portfolio intelligence, creative work, and studio planning.'],
  ['Where can I get product support?', 'Bronzed and Stellar each have their own support and legal pages. Follow the product link below, then choose Support from its navigation.'],
];
---

<BaseLayout
  title="Camm Studios — Consumer apps that compound"
  description="Camm Studios finds overlooked consumer needs, builds focused native apps, and improves them through a shared operating system."
  canonical={canonical}
  image={socialImage}
  structuredData={structuredData}
>
  <Nav links={[{ href: '#operate', label: 'How we operate' }, { href: '#systems', label: 'Systems' }, { href: '#apps', label: 'Apps' }]} />
  <main id="main">
    <section class="company-hero shell">
      <div class="company-hero__copy">
        <p class="eyebrow" data-reveal>Independent consumer app company</p>
        <h1 data-word-reveal>We build consumer apps that compound.</h1>
        <p class="company-hero__lede" data-reveal>Camm Studios turns overlooked demand into focused native products, then improves them through a shared operating system.</p>
        <div class="company-hero__actions" data-reveal>
          <a class="button button--light" href="#operate">See how we operate</a>
          <p><span>Live products</span><a href="https://bronzed.cammstudios.com">Bronzed</a><a href="https://stellar.cammstudios.com">Stellar</a></p>
        </div>
      </div>
      <div class="company-hero__object">
        <ThreeScene
          scene="monogram"
          label="A clear robotic snake preserving the Camm Studios C silhouette, with articulated joints and an optical eye"
          modelUrl={snakeModel}
          poster={mark}
          accent="#ffffff"
        />
        <div class="object-index" aria-hidden="true"><span>ROBOTIC SERPENT / 001</span><span>REFRACTIVE IDENTITY</span></div>
      </div>
    </section>

    <section class="reading-moment shell" aria-labelledby="company-thesis">
      <p class="eyebrow">The studio thesis</p>
      <h2 id="company-thesis" data-reading-reveal>From signal to software to scale. Every product makes the studio sharper for the next.</h2>
    </section>

    <section class="operate-section" id="operate" aria-labelledby="operate-title">
      <div class="shell operate-section__layout">
        <header class="operate-section__intro">
          <p class="eyebrow">How we operate / 01</p>
          <h2 id="operate-title">One loop.<br />Four decisions.</h2>
          <p>We do not begin with a feature list. We begin with evidence, narrow the problem, ship the clearest version, and let real use challenge our assumptions.</p>
        </header>
        <div class="operating-loop">
          {operatingLoop.map((step) => (
            <article class="loop-step" data-reveal>
              <p class="loop-step__number">{step.number}</p>
              <div><h3>{step.title}</h3><p>{step.body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="judgment-section">
      <div class="shell judgment-section__layout">
        <p class="eyebrow">Our judgment / 02</p>
        <h2 data-reading-reveal>AI shortens the path. People decide what deserves to ship.</h2>
        <div class="judgment-section__body" data-reveal>
          <p>Automation helps us move from broad evidence to working software quickly.</p>
          <p>People still decide what is useful, understandable, responsible, and worth keeping.</p>
        </div>
      </div>
    </section>

    <section class="systems-section shell" id="systems" aria-labelledby="systems-title">
      <header class="section-heading">
        <p class="eyebrow">Studio systems / 03</p>
        <h2 id="systems-title">The tools behind the products.</h2>
        <p>We build internal systems to make decisions with more context and less guesswork. Automation supports judgment. It does not replace it.</p>
      </header>
      <div class="systems-grid">
        {systems.map((system) => <SystemCard {...system} />)}
      </div>
    </section>

    <section class="apps-section" id="apps" aria-labelledby="apps-title">
      <div class="shell">
        <header class="section-heading section-heading--wide">
          <p class="eyebrow">Live products / 04</p>
          <h2 id="apps-title">Different problems.<br />The same focused operating system.</h2>
        </header>
        <div class="apps-grid">
          <a class="app-portal app-portal--bronzed" href="https://bronzed.cammstudios.com" data-reveal>
            <div class="app-portal__top"><span>Weather and wellbeing</span><span>↗</span></div>
            <div class="app-portal__identity"><Image src={products.bronzed.icon} alt="Bronzed app icon" width={128} height={128} format="webp" /><h3>Bronzed</h3></div>
            <p>Live UV and personal context, turned into clearer outdoor guidance.</p>
            <Image class="app-portal__art" src={products.bronzed.portalArt} alt="" width={1024} quality={88} loading="lazy" aria-hidden="true" />
          </a>
          <a class="app-portal app-portal--stellar" href="https://stellar.cammstudios.com" data-reveal>
            <div class="app-portal__top"><span>Daily reflection</span><span>↗</span></div>
            <div class="app-portal__identity"><Image src={products.stellar.icon} alt="Stellar app icon" width={128} height={128} format="webp" /><h3>Stellar</h3></div>
            <p>Affirmations, journaling, and vision boards, brought into a steady daily ritual.</p>
            <Image class="app-portal__art" src={products.stellar.portalArt} alt="" width={1024} quality={88} loading="lazy" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section class="company-faq shell" aria-labelledby="company-faq-title">
      <header class="section-heading">
        <p class="eyebrow">Questions / 05</p>
        <h2 id="company-faq-title">A clearer view of the studio.</h2>
      </header>
      <div class="faq-list">
        {questions.map(([question, answer], index) => (
          <details data-reveal>
            <summary><span>0{index + 1}</span>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="company-close shell">
      <p class="eyebrow">The portfolio is live</p>
      <h2>Start with the product<br />that solves your problem.</h2>
      <div><a class="button button--light" href="https://bronzed.cammstudios.com">Explore Bronzed</a><a class="button" href="https://stellar.cammstudios.com">Explore Stellar</a></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
