---
import { Image } from 'astro:assets';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Nav from '@shared/components/Nav.astro';
import Footer from '@shared/components/Footer.astro';
import ThreeScene from '@shared/components/ThreeScene.astro';
import mark from '@shared/assets/brand/crystal/snake.webp';
import bronzedIcon from '@shared/assets/product/bronzed-icon.png';
import stellarIcon from '@shared/assets/product/stellar-icon.png';
import bronzedPortalArt from '@shared/assets/art/crystal/bronzed-solar.webp';
import stellarPortalArt from '@shared/assets/art/crystal/stellar-orbit.webp';
import artemisArt from '@shared/assets/art/crystal/artemis.webp';
import atlasArt from '@shared/assets/art/crystal/atlas.webp';
import { companySite } from '@shared/data/site';
import '@shared/styles/company.css';

const canonical = new URL('/', Astro.site);
const socialImage = new URL(mark.src, Astro.site);
const products = {
  bronzed: {
    name: 'Bronzed',
    appStoreTitle: 'Bronzed — Tan Timer & UV Index',
    url: 'https://bronzed.cammstudios.com',
    icon: bronzedIcon,
    portalArt: bronzedPortalArt,
  },
  stellar: {
    name: 'Stellar',
    appStoreTitle: 'Stellar — Mantra & Ritual',
    url: 'https://stellar.cammstudios.com',
    icon: stellarIcon,
    portalArt: stellarPortalArt,
  },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: companySite.name,
  url: companySite.url,
  logo: socialImage.toString(),
  email: companySite.email,
  description: companySite.description,
  owns: Object.values(products).map((app) => ({
    '@type': 'MobileApplication',
    name: app.appStoreTitle,
    url: app.url,
  })),
};

const operatingLoop = [
  { number: '01', title: 'Independent thinking.', body: 'We make our own decisions and put our conviction into the products we build.' },
  { number: '02', title: 'Care in the details.', body: 'Useful software should feel considered, from the first interaction to the everyday routine.' },
  { number: '03', title: 'Lasting ownership.', body: 'We build products to own and operate for the long term.' },
  { number: '04', title: 'Always improving.', body: 'A launch is a beginning. Our commitment continues with every release.' },
];
const systems = [{ name: 'Artemis', art: artemisArt }, { name: 'Atlas', art: atlasArt }];
const questions = [
  ['What is Camm Studios?', 'An independent studio that designs, builds, and operates its own iOS apps. Every product stays close to the person who makes it.'],
  ['Is the studio an agency?', 'The studio works on its own products and does not take client or contract work.'],
  ['Where can I get app support?', 'Each app has its own website, guides, and support page. You can also email info@cammstudios.com.'],
];
---

<BaseLayout title="Camm Studios | Independent minds. Lasting products." description="An independent studio building and operating focused iOS apps. Research, thoughtful design, and continuous improvement, from the first idea to every release." canonical={canonical} image={socialImage} structuredData={structuredData}>
  <Nav links={[{ href: '#operate', label: 'Our approach' }, { href: '#systems', label: 'Our systems' }, { href: '#apps', label: 'Our apps' }, { href: 'mailto:info@cammstudios.com', label: 'Get in touch ↗' }]} />
  <main id="main">
    <section class="company-hero shell" aria-labelledby="hero-title">
      <div class="hero-meta"><span><i></i> Independent product studio</span><span>Melbourne, Australia</span></div>
      <div class="company-hero__copy">
        <p class="eyebrow" data-reveal>Curiosity, made useful.</p>
        <h1 id="hero-title"><span class="hero-line">Independent minds.</span><span class="hero-line">Lasting products.</span></h1>
        <p class="company-hero__lede" data-reveal>We turn overlooked problems into thoughtful apps. Then we keep making them better.</p>
        <div class="company-hero__actions" data-reveal><a class="button button--light" href="#operate">Inside the studio <span aria-hidden="true">↗</span></a><a class="text-link" href="#apps">Explore our apps <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="company-hero__object">
        <div class="instrument-orbit" aria-hidden="true"></div>
        <ThreeScene scene="monogram" label="A transparent robotic snake with crystal panels, articulated joints, and an optical eye. It slithers into a C-shaped mark." poster={mark} accent="#ffffff" />
        <span class="object-coordinate object-coordinate--top" aria-hidden="true">C / 001</span>
        <span class="object-coordinate object-coordinate--bottom" aria-hidden="true">FORM FOLLOWS PURPOSE</span>
      </div>
      <div class="hero-footer"><span>Research-led. Design-minded. Built to endure.</span><a href="#operate">Scroll to discover <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="studio-intro shell" id="operate" aria-labelledby="approach-title">
      <p class="eyebrow">01 / Our approach</p>
      <div><h2 id="approach-title" data-reveal>Good products don’t<br />happen by chance.</h2><p class="studio-intro__body">They come from asking better questions, paying attention to the details, and staying with a problem long enough to solve it well. That is how we work.</p></div>
    </section>
    <section class="operate-section shell" aria-label="Our operating principles">
      <div class="operating-loop">{operatingLoop.map((step) => <article class="loop-step" data-reveal><p class="loop-step__number">{step.number} /</p><h3>{step.title}</h3><p>{step.body}</p></article>)}</div>
      <div class="operating-note"><span class="eyebrow">An independent point of view</span><p>Small by design. We own our products, make our own decisions, and build for the people who use them.</p></div>
    </section>

    <section class="systems-section" id="systems" aria-labelledby="systems-title">
      <div class="shell">
        <header class="systems-heading"><div><p class="eyebrow">02 / Proprietary technology</p><h2 id="systems-title">Built behind the scenes.<br /><span>Felt in every product.</span></h2></div><p>Our own technology. Developed in-house, for the way we build.</p></header>
        <div class="technology-gallery">{systems.map((system) => <article class="technology-object" data-reveal><Image src={system.art} alt={`An abstract metal sculpture representing ${system.name}`} width={900} quality={88} loading="lazy" /><h3>{system.name}</h3></article>)}</div>
      </div>
    </section>

    <section class="apps-section shell" id="apps" aria-labelledby="apps-title">
      <header class="section-heading--wide"><div><p class="eyebrow">03 / Our portfolio</p><h2 id="apps-title">Different needs.<br />The same care.</h2></div><p>Focused iOS apps, each with a world of its own.</p></header>
      <div class="apps-grid">
        <a class="app-portal app-portal--bronzed" href="https://bronzed.cammstudios.com" data-reveal><div class="app-portal__top"><span>01 / Time outdoors</span><span>↗</span></div><Image class="app-portal__art" src={products.bronzed.portalArt} alt="" width={800} quality={85} loading="lazy" /><div class="app-portal__identity"><Image src={products.bronzed.icon} alt="" width={80} height={80} format="webp" /><div><h3>Bronzed</h3><p>Tan timer & UV index</p></div><span aria-hidden="true">↗</span></div><div class="app-portal__domain">bronzed.cammstudios.com <span>Explore the app</span></div></a>
        <a class="app-portal app-portal--stellar" href="https://stellar.cammstudios.com" data-reveal><div class="app-portal__top"><span>02 / Daily reflection</span><span>↗</span></div><Image class="app-portal__art" src={products.stellar.portalArt} alt="" width={800} quality={85} loading="lazy" /><div class="app-portal__identity"><Image src={products.stellar.icon} alt="" width={80} height={80} format="webp" /><div><h3>Stellar</h3><p>Affirmations & journaling</p></div><span aria-hidden="true">↗</span></div><div class="app-portal__domain">stellar.cammstudios.com <span>Explore the app</span></div></a>
      </div>
      <div class="portfolio-guides"><span>More to discover</span><p>Practical reading, written for each app.</p><a href="https://bronzed.cammstudios.com/blog/">Bronzed guides ↗</a><a href="https://stellar.cammstudios.com/blog/">Stellar guides ↗</a></div>
    </section>

    <section class="company-faq shell" aria-labelledby="faq-title"><header><p class="eyebrow">04 / A little more context</p><h2 id="faq-title">Good questions.</h2></header><div class="faq-list">{questions.map(([question, answer], index) => <details><summary><span>0{index + 1}</span>{question}</summary><p>{answer}</p></details>)}</div></section>
    <section class="company-close shell"><p class="eyebrow">Have something in mind?</p><h2>Let’s talk.</h2><a href="mailto:info@cammstudios.com">info@cammstudios.com <span aria-hidden="true">↗</span></a></section>
  </main>
  <Footer />
</BaseLayout>
