---
import LegalLayout from '@shared/layouts/LegalLayout.astro';
---

<LegalLayout title="Support — Camm Studios" description="Get support for Camm Studios and its apps." canonical={new URL('/support', Astro.site)} heading="Support">
  <h2>How can we help?</h2>
  <p>For help with Bronzed, Stellar, billing, privacy, or anything else, email <a href="mailto:info@cammstudios.com">info@cammstudios.com</a>. We aim to reply within 24 hours.</p>
  <h2>App support</h2>
  <p>Tell us which app you use, your device model, iOS version, and what happened. Please do not send health information, journal content, or other sensitive personal data.</p>
  <ul>
    <li><a href="https://bronzed.cammstudios.com/support">Bronzed support</a></li>
    <li><a href="https://stellar.cammstudios.com/support">Stellar support</a></li>
  </ul>
  <h2>Subscriptions and refunds</h2>
  <p>Apple handles App Store billing. You can manage a subscription in your Apple ID settings or <a href="https://reportaproblem.apple.com/">request a refund from Apple</a>.</p>
</LegalLayout>
