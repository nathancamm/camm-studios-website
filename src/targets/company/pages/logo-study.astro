---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Nav from '@shared/components/Nav.astro';
import Footer from '@shared/components/Footer.astro';
import precision from '@shared/assets/brand/crystal/01-precision.webp';
import prism from '@shared/assets/brand/crystal/02-prism.webp';
import strata from '@shared/assets/brand/crystal/03-strata.webp';
import interlock from '@shared/assets/brand/crystal/04-interlock.webp';
import orbit from '@shared/assets/brand/crystal/05-orbit.webp';
import '@shared/styles/logo-study.css';
const concepts = [
  { name: 'Precision', kind: 'The essential C', image: precision, description: 'A single polished volume. Open, deliberate, and recognisable at a glance.' },
  { name: 'Prism', kind: 'The faceted C', image: prism, description: 'Cut planes catch the light. A sharper, more crystalline expression of the initial.' },
  { name: 'Strata', kind: 'The layered C', image: strata, description: 'Parallel glass layers add rhythm and depth to a familiar silhouette.' },
  { name: 'Interlock', kind: 'The CS monogram', image: interlock, description: 'Two forms share one composition. An identity built around the whole studio name.' },
  { name: 'Orbit', kind: 'The abstract mark', image: orbit, description: 'Intersecting curves form an open optical sculpture. Less literal, more spatial.' },
];
---
<BaseLayout title="Camm Studios | Five crystal identities" description="Five clear glass logo directions for Camm Studios, sculpted and rendered in Blender." canonical={new URL('/logo-study/', Astro.site)} robots="noindex, nofollow">
  <Nav links={[{ href: '/', label: 'Back to the studio ↗' }]} />
  <main id="main" class="logo-study shell">
    <header class="logo-study__header"><div><p class="eyebrow">Camm Studios / Identity exploration</p><h1>Five forms.<br />One clear direction.</h1></div><p>Colourless glass. Cool white light. Five distinct ways to express the studio, from a precise initial to an abstract object.</p></header>
    <section class="logo-study__grid" aria-label="Five clear crystal logo options">
      {concepts.map((concept, index) => <article class="logo-concept">
        <div class="logo-concept__stage"><span class="logo-concept__index">0{index + 1} / {concept.kind}</span><img src={concept.image.src} width="960" height="960" alt={`${concept.name}, a colourless glass Camm Studios logo on white`} loading={index === 0 ? 'eager' : 'lazy'} /></div>
        <div class="logo-concept__body"><div><p class="eyebrow">Direction 0{index + 1}</p><h2>{concept.name}</h2></div><p>{concept.description}</p><a href={concept.image.src} download>Download render <span aria-hidden="true">↘</span></a></div>
      </article>)}
    </section>
    <footer class="logo-study__footer"><p>Private identity study · Excluded from search engines</p><a href="/">View the website ↗</a></footer>
  </main>
  <Footer />
</BaseLayout>
