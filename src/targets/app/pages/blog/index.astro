---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Nav from '@shared/components/Nav.astro';
import Footer from '@shared/components/Footer.astro';
import app from '@app-data';
import { appNavLinks } from '@shared/data/app-nav';
import '@shared/styles/blog.css';

const posts = (await getCollection('blog', ({ data }) => data.app === app.target && !data.draft))
  .sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf());
const intro = app.target === 'bronzed'
  ? 'Clear answers about UV, SPF, weather, and planning time outdoors.'
  : 'Grounded ways to use affirmations, journaling, vision boards, and daily reflection.';
const socialAsset = await getImage({ src: app.icon, width: 512, format: 'webp', quality: 86 });
---

<BaseLayout
  title={`${app.name} Guides — Practical answers and routines`}
  description={intro}
  canonical={new URL('/blog', Astro.site)}
  image={new URL(socialAsset.src, Astro.site)}
  themeClass={app.themeClass}
>
  <Nav product={app.name} links={appNavLinks(app)} storeUrl={app.storeUrl} />
  <main id="main" class="blog-index shell">
    <header class="blog-index__header">
      <div>
        <p class="eyebrow" data-reveal>{app.name} guides</p>
        <h1 data-word-reveal>Useful context before the next step.</h1>
      </div>
      <div class="blog-index__intro" data-reveal>
        <p>{intro}</p>
        <span>{posts.length.toString().padStart(2, '0')} published guides</span>
      </div>
    </header>

    <section class="post-grid" aria-label={`${app.name} articles`}>
      {posts.map((post, index) => (
        <a class="post-card" href={`/blog/${post.data.slug}`} data-reveal>
          <div class="post-card__visual" aria-hidden="true">
            <span class="post-card__number">{(index + 1).toString().padStart(2, '0')}</span>
            <Image class="post-card__art" src={app.guideArt[post.data.slug]} alt="" width={1200} quality={88} loading={index === 0 ? 'eager' : 'lazy'} />
            <span class="post-card__topic">{post.data.keywords[0]}</span>
          </div>
          <div class="post-card__body">
            <p>{post.data.publicationDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <h2>{post.data.title}</h2>
            <span>Read guide ↗</span>
          </div>
        </a>
      ))}
    </section>

    <aside class="editorial-note" data-reveal>
      <p class="eyebrow">Editorial approach</p>
      <p>{app.target === 'bronzed'
        ? 'Health and UV guidance is sourced, limitations stay visible, and the app is never presented as protection from sun damage.'
        : 'Reflection practices are presented as tools for attention and habit, never as guarantees of external outcomes.'}</p>
    </aside>
  </main>
  <Footer product={app.name} />
</BaseLayout>
