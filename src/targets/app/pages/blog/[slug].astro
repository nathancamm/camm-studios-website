---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Nav from '@shared/components/Nav.astro';
import Footer from '@shared/components/Footer.astro';
import blogUv from '@shared/assets/art/blog-uv.png';
import blog369 from '@shared/assets/art/blog-369.png';
import { apps, getCurrentApp, type AppTarget } from '@shared/data/apps';
import '@shared/styles/blog.css';

export const getStaticPaths = (async () => {
  const target = process.env.SITE_TARGET as AppTarget;
  const posts = await getCollection('blog', ({ data }) => data.app === target && !data.draft);
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const app = getCurrentApp();
const { Content } = await render(post);
const imageMap = { 'blog-uv': blogUv, 'blog-369': blog369 };
const hero = imageMap[post.data.heroImage as keyof typeof imageMap];
const canonical = new URL(`/blog/${post.data.slug}`, Astro.site);
const socialImage = new URL(hero.src, Astro.site);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.summary,
    datePublished: post.data.publicationDate.toISOString(),
    dateModified: post.data.updatedDate.toISOString(),
    image: socialImage.toString(),
    mainEntityOfPage: canonical.toString(),
    author: { '@type': 'Organization', name: 'Camm Studios', url: 'https://www.cammstudios.com' },
    publisher: { '@type': 'Organization', name: 'Camm Studios', url: 'https://www.cammstudios.com' },
    keywords: post.data.keywords.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: app.name, item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Journal', item: new URL('/blog', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical.toString() },
    ],
  },
];
---

<BaseLayout title={`${post.data.title} — ${app.name}`} description={post.data.summary} canonical={canonical} image={socialImage} themeClass={app.themeClass} structuredData={structuredData}>
  <Nav product={app.name} links={[{ href: '/', label: app.name }, { href: '/blog', label: 'Journal' }, { href: '/support', label: 'Support' }]} storeUrl={app.storeUrl} />
  <main id="main">
    <header class="article-hero shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">{app.name}</a><span>/</span><a href="/blog">Journal</a><span>/</span><span>Guide</span></nav>
      <p class="eyebrow">{app.name} Journal</p>
      <h1 data-word-reveal>{post.data.title}</h1>
      <p class="article-hero__summary" data-reveal>{post.data.summary}</p>
      <p class="article-hero__meta"><span>{post.data.publicationDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</span><span>{Math.max(4, Math.round((post.body?.length ?? 3600) / 900))} minute read</span></p>
    </header>
    <figure class="article-image" data-reveal><Picture src={hero} alt={post.data.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 800px) calc(100vw - 32px), calc(100vw - 8vw)" formats={['avif', 'webp']} loading="eager" /></figure>
    <div class="article-grid shell">
      <aside class="article-share"><p>Published by<br /><strong>Camm Studios</strong></p><p><a href={`/rss.xml`}>RSS feed</a></p></aside>
      <article class="article-body">
        <Content />
        {post.data.sources.length > 0 && <section class="article-sources"><h2>Sources</h2><ul>{post.data.sources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul></section>}
      </article>
    </div>
  </main>
  <Footer product={apps[app.target].name} />
</BaseLayout>
