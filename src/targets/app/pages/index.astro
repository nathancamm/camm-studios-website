---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Nav from '@shared/components/Nav.astro';
import Footer from '@shared/components/Footer.astro';
import StoreButton from '@shared/components/StoreButton.astro';
import ThreeScene from '@shared/components/ThreeScene.astro';
import app from '@app-data';
import '@shared/styles/app.css';

const canonical = new URL('/', Astro.site);
const socialAsset = await getImage({ src: app.icon, width: 512, format: 'webp', quality: 86 });
const socialImage = new URL(socialAsset.src, Astro.site);
const posts = (await getCollection('blog', ({ data }) => data.app === app.target && !data.draft))
  .sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf())
  .slice(0, 3);
const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: app.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const appStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: app.appStoreTitle,
  operatingSystem: 'iOS',
  applicationCategory: app.target === 'bronzed' ? 'HealthApplication' : 'LifestyleApplication',
  description: app.seoDescription,
  url: canonical.toString(),
  downloadUrl: app.storeUrl,
  author: { '@type': 'Organization', name: 'Camm Studios', url: 'https://www.cammstudios.com' },
};
const privacyCopy = app.target === 'bronzed'
  ? 'Your profile, session history, and progress photos stay on your device. Location is optional. Analytics, attribution, weather, and subscription services receive only the data explained in our policy.'
  : 'Your journal text, custom affirmations, and vision board content stay on your device. Limited profile, analytics, attribution, and subscription data is processed as explained in our policy.';
const readingStatement = app.target === 'bronzed'
  ? 'The weather tells you what is happening. Bronzed helps you decide what to do next.'
  : 'Intentions fade when they have nowhere to live. Stellar gives them a quiet place to return.';
const sceneSecondary = app.target === 'bronzed' ? '#ffd6a8' : '#b8c2ff';
---

<BaseLayout
  title={`${app.name} — ${app.tagline}`}
  description={app.seoDescription}
  canonical={canonical}
  image={socialImage}
  themeClass={app.themeClass}
  structuredData={[appStructuredData, faqStructuredData]}
>
  <Nav
    product={app.name}
    links={[{ href: '#features', label: 'Features' }, { href: '/blog', label: 'Guides' }, { href: '/support', label: 'Support' }]}
    storeUrl={app.storeUrl}
  />
  <main id="main">
    <section class="app-hero shell">
      <div class="app-hero__copy">
        <div class="app-identity" data-reveal>
          <Image src={app.icon} alt={`${app.name} app icon`} width={112} height={112} format="webp" loading="eager" />
          <div><p>{app.name}</p><span>by Camm Studios</span></div>
        </div>
        <p class="eyebrow" data-reveal>{app.eyebrow}</p>
        <h1 data-word-reveal>{app.tagline}</h1>
        <p class="app-hero__lede" data-reveal>{app.description}</p>
        <div class="app-hero__actions" data-reveal>
          <StoreButton href={app.storeUrl} label={`Download ${app.name}`} />
          <span>Available on the App Store</span>
        </div>
        {app.target === 'bronzed' && <p class="app-hero__notice" data-reveal>No app can prevent sunburn. Bronzed provides estimates and general guidance, not medical advice. Always follow official sun protection advice.</p>}
      </div>
      <div class="app-hero__object">
        <ThreeScene
          scene={app.target}
          label={app.target === 'bronzed' ? 'A clear UV measurement lens with attenuation bands and calibrated index marks' : 'A clear 3, 6, and 9 ritual instrument resolving into a crystal rosette'}
          accent={app.accent}
          secondary={sceneSecondary}
        />
        <div class="object-index" aria-hidden="true"><span>{app.target.toUpperCase()} / LIVE</span><span>NATIVE iOS</span></div>
      </div>
    </section>

    <aside class="product-index" aria-label={`${app.name} facts`}>
      <div><span>01</span><p><strong>Built for iPhone</strong>Native iOS experience</p></div>
      <div><span>02</span><p><strong>{app.category}</strong>App Store category</p></div>
      <div><span>03</span><p><strong>Privacy explained</strong>Clear product policy</p></div>
    </aside>

    <section class="app-reading shell">
      <p class="eyebrow">The product promise</p>
      <h2 data-reading-reveal>{readingStatement}</h2>
    </section>

    <section class="product-story" id="features" aria-labelledby="features-title">
      <div class="shell product-story__layout">
        <div class="product-stage" data-product={app.target} data-reveal>
          <div class="product-stage__instrument" aria-hidden="true">
            <span class="product-stage__grid"></span><span class="product-stage__halo product-stage__halo--outer"></span>
            <span class="product-stage__halo product-stage__halo--middle"></span><span class="product-stage__halo product-stage__halo--inner"></span>
            <span class="product-stage__arc"></span><span class="product-stage__trace product-stage__trace--one"></span><span class="product-stage__trace product-stage__trace--two"></span>
            <span class="product-stage__scan"></span><span class="product-stage__datum product-stage__datum--one"></span><span class="product-stage__datum product-stage__datum--two"></span>
          </div>
          <div class="device-frame">
            <Image src={app.screenshot} alt={`Real ${app.name} app interface`} width={390} format="webp" quality={90} loading="eager" />
          </div>
          <p>Real app interface</p>
        </div>
        <div class="feature-ledger">
          <header>
            <p class="eyebrow">Inside {app.name} / 01</p>
            <h2 id="features-title">{app.target === 'bronzed' ? 'A clearer way to read the sun.' : 'A calm place to return to your intention.'}</h2>
          </header>
          {app.features.map((feature, index) => (
            <article class="feature-row" data-reveal>
              <span>0{index + 1}</span>
              <div><h3>{feature.title}</h3><p>{feature.body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="steps-section shell" aria-labelledby="steps-title">
      <header class="section-heading">
        <p class="eyebrow">{app.target === 'bronzed' ? 'A focused session / 02' : 'Three moments each day / 02'}</p>
        <h2 id="steps-title">{app.target === 'bronzed' ? 'From conditions to a useful decision.' : 'A ritual simple enough to repeat.'}</h2>
      </header>
      <div class="steps-grid">
        {app.steps.map((step) => (
          <article class="step" data-reveal><p>{step.number}</p><h3>{step.title}</h3><span>{step.body}</span></article>
        ))}
      </div>
    </section>

    <section class="privacy-section shell">
      <div class="privacy-panel" data-reveal>
        <div><p class="eyebrow">Privacy, stated plainly / 03</p><h2>Your personal content belongs to you.</h2></div>
        <div><p>{privacyCopy}</p><a class="text-link" href="/privacy">Read the full privacy policy <span>↗</span></a></div>
      </div>
    </section>

    <section class="app-faq shell" aria-labelledby="faq-title">
      <header class="section-heading">
        <p class="eyebrow">Questions / 04</p>
        <h2 id="faq-title">What to know before you start.</h2>
      </header>
      <div class="faq-list">
        {app.faqs.map((faq, index) => (
          <details data-reveal><summary><span>0{index + 1}</span>{faq.question}</summary><p>{faq.answer}</p></details>
        ))}
      </div>
    </section>

    <section class="guides-section shell" aria-labelledby="guides-title">
      <header class="section-heading section-heading--row">
        <div><p class="eyebrow">Practical guides / 05</p><h2 id="guides-title">Built for the questions people already ask.</h2></div>
        <a class="text-link" href="/blog">View all guides <span>↗</span></a>
      </header>
      <div class="guide-grid">
        {posts.map((post, index) => (
          <a class="guide-card" href={`/blog/${post.data.slug}`} data-reveal>
            <div><span>0{index + 1}</span><span>{post.data.publicationDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}</span></div>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
            <span class="guide-card__arrow">Read guide ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="download-panel">
      <div class="shell">
        <p class="eyebrow">Available now</p>
        <h2>{app.target === 'bronzed' ? 'Meet the sun with better context.' : 'Make space for a steadier ritual.'}</h2>
        <StoreButton href={app.storeUrl} label={`Download ${app.name}`} class="button--light" />
      </div>
    </section>
  </main>
  <Footer product={app.name} />
</BaseLayout>
