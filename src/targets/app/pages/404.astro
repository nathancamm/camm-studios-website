---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Nav from '@shared/components/Nav.astro';
import Footer from '@shared/components/Footer.astro';
import { getCurrentApp } from '@shared/data/apps';
const app = getCurrentApp();
---

<BaseLayout title={`Page not found — ${app.name}`} description="This page could not be found." canonical={new URL('/404', Astro.site)} robots="noindex, follow" themeClass={app.themeClass}>
  <Nav product={app.name} links={[{ href: '/', label: app.name }, { href: '/blog', label: 'Journal' }, { href: '/support', label: 'Support' }]} storeUrl={app.storeUrl} />
  <main id="main" class="shell section" style="min-height:80svh;padding-top:192px">
    <p class="eyebrow">404 / Signal lost</p>
    <h1 class="display">This path has left the ritual.</h1>
    <a class="button button--ink" href="/">Return to {app.name}</a>
  </main>
  <Footer product={app.name} />
</BaseLayout>
